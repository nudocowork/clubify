enum Role {
  // PLATFORM_OWNER (2026-06-13): Super Admin de la PLATAFORMA (Nivel 1).
  // Está por encima de SUPER_ADMIN — gestiona Marcas Blancas (Clubify es
  // una de ellas) desde /superadmin. NO tiene tenantId. Sus permisos
  // son globales sobre todas las marcas + créditos + módulos + integraciones.
  PLATFORM_OWNER
  SUPER_ADMIN
  TENANT_OWNER
  TENANT_STAFF
  // Rol global con acceso solo a marketing y diseño en todos los negocios.
  // Sin scanner, sin financiero, sin crear negocios, sin gestión de admins.
  MARKETING
  // Roles para el panel de afiliados (/affiliate). Cada User con uno
  // de estos roles está vinculado vía User.referralCodeId a SU código
  // y solo ve sus propios clientes/comisiones (scoped en AffiliateService).
  AFFILIATE_INFLUENCER
  AFFILIATE_AMBASSADOR
  // Vendedor del equipo de un embajador. Ve solo SUS ventas/comisiones
  // (scoped por User.referralCodeId apuntando a un ReferralCode de
  // role=VENDOR). El embajador crea el vendor + cuenta de login.
  AFFILIATE_VENDOR
  // El Socio recibe 10% de TODAS las ventas. Su panel muestra el
  // ledger de su código SOCIO (sin "clientes propios").
  AFFILIATE_SOCIO
  // Red de Domicilios — Fase 2 (2026-06-30): cuenta de una EMPRESA de
  // domicilios. Vinculada vía User.deliveryCompanyId. Sin tenantId ni
  // whiteLabelId. Su portal (/domicilios) muestra SOLO los domicilios de
  // su empresa. Los guards de tenant la dejan pasar (no tiene tenant).
  DELIVERY_COMPANY
  // Cuponera / Living Card — Fase 2: cuenta de un NEGOCIO ALIADO. Vinculada
  // vía User.allyBusinessId. Sin tenantId. Su portal (/cuponera/negocio)
  // gestiona SOLO su ficha/promos. Mismo patrón que DELIVERY_COMPANY.
  ALLY_BUSINESS
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum CardType {
  STAMPS
  POINTS
  DISCOUNT
  MEMBERSHIP
  COUPON
  GIFT
  MULTI
  // CASHBACK: % devuelto en saldo de moneda. El cliente acumula
  // pesos/dolares y los canjea contra futuras compras.
  CASHBACK
  // VISITS: tarjeta tipo punch card pero la métrica es "visitas registradas",
  // no compras. Útil para gimnasios, peluquerías, lavaderos donde lo
  // que importa es la frecuencia, no el ticket.
  VISITS
  // HYBRID: tarjeta combinada — sellos + puntos + descuento en una sola.
  // Sucesor de MULTI con UI activa en el wizard. Internamente
  // comparten lógica.
  HYBRID
}

