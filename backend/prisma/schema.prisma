// ============================================================
//                       CORE
// ============================================================

model Plan {
  id               String   @id @default(uuid())
  name             String   @unique
  maxLocations     Int      @default(3)
  maxCards         Int      @default(5)
  maxCustomers     Int      @default(1000)
  maxProducts      Int      @default(50)
  maxOrdersMonth   Int      @default(500)
  pushIncluded     Int      @default(1000)
  whatsappIncluded Int      @default(1000)
  priceMonthly     Decimal  @default(0) @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  tenants          Tenant[]
}

/// Configuración global de Clubify (singleton key/value).
/// Uso: branding del panel y favicon — actualizable desde super admin sin
/// redeploy. Cualquier setting global futuro entra acá también.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Refresh tokens persistidos para soportar rotation + revocation.
// Cada refresh emitido vive una sola vez: al usarse se marca como
// `replacedByTokenId` apuntando al nuevo token de la misma familia.
// Si un token YA rotado se intenta usar de nuevo → reuso sospechoso,
// la familia entera se revoca (token reuse detection). El `familyId`
// agrupa todos los refresh derivados de un mismo login.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA256 hex del token. NUNCA guardamos el token plano.
  tokenHash         String    @unique
  // Agrupa rotation chain. Al detectar reuso se revoca toda la family.
  familyId          String
  expiresAt         DateTime
  revokedAt         DateTime?
  // Si fue rotado, apunta al token nuevo de la misma family.
  replacedByTokenId String?
  // Metadata diagnóstica (no PII sensible).
  ip                String?
  userAgent         String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Tenant {
  id                          String                     @id @default(uuid())
  /// Marca Blanca a la que pertenece este negocio (Nivel 3 → Nivel 2).
  /// Nullable solo durante el backfill — todos los tenants existentes se
  /// asignan a la marca "Clubify" en la migration de 2026-06-13.
  whiteLabelId                String?
  whiteLabel                  WhiteLabel?                @relation(fields: [whiteLabelId], references: [id], onDelete: SetNull)
  /// Grupo Empresarial al que pertenece (varios negocios, una sola suscripción
  /// Hotmart). Null = sin grupo (negocio individual). El estado financiero del
  /// grupo cascadea al status de sus negocios.
  businessGroupId             String?
  businessGroup               BusinessGroup?             @relation(fields: [businessGroupId], references: [id], onDelete: SetNull)
  /// Modo de reparto de comisión del vendedor (Fase 3). Default = descuento del
  /// upline (comportamiento histórico). El modo se CONGELA en cada comisión al
  /// generarla, así cambiarlo no altera comisiones pasadas.
  commissionDistributionMode  CommissionDistributionMode @default(DISCOUNT_FROM_INFLUENCER)
  name                        String
  brandName                   String
  slug                        String                     @unique
  email                       String
  phone                       String?
  whatsappPhone               String?
  // URL completa de Google Reviews del negocio (el dueño la pega desde
  // Google Business Profile → Get more reviews → "Compartir formulario").
  // Usado por /r/{slug} review filter: clientes con 4-5★ van directo
  // a Google; <4★ se redirigen a feedback privado en /api/public/r/.
  googleReviewUrl             String?
  // WhatsApp opcional al cierre del feedback negativo (1-3 ⭐) en /r/:slug.
  // Cuando el dueño lo configura, el cliente ve un botón "Hablar por
  // WhatsApp" al final del formulario privado para escalar quejas
  // directamente. Independiente de whatsappPhone (que es el WhatsApp
  // general del negocio para pedidos/contacto).
  whatsappFeedbackEnabled     Boolean                    @default(false)
  /// Número en formato libre (E.164 recomendado: +57...). Si vacío con
  /// enabled=true, el botón no se muestra.
  whatsappFeedbackNumber      String?
  /// Mensaje predeterminado que se carga en el chat al tocar el botón.
  /// Tokens soportados: {businessName} {customerName} {rating}. Null =
  /// mensaje default del frontend ("Hola, acabo de dejar una reseña...").
  whatsappFeedbackMessage     String?
  // Mensajería del flujo de pedidos (Pro-only):
  // - whatsappOrdersPhone: número del NEGOCIO/CAJA donde el cliente envía
  //   sus pedidos desde el menú (mesa o delivery). Si está vacío usa
  //   whatsappPhone como fallback.
  // - whatsappDeliveryPhone: número del COURIER/empresa de domicilio.
  //   Cuando el negocio acepta el pago de un pedido DELIVERY se abre un
  //   wa.me a este número con el resumen + dirección.
  whatsappOrdersPhone         String?
  whatsappDeliveryPhone       String?
  // WhatsApp donde el negocio recibe el AVISO de cada reserva nueva (para
  // confirmarla manualmente). Si null, el aviso cae a whatsappPhone y luego
  // a phone. Configurable por el dueño en /app/settings (PDF Software 2026-06-29).
  whatsappReservationsPhone   String?
  logoUrl                     String?
  // Logo específico para las tarjetas wallet (header de Apple/Google
  // Wallet). Si null, fallback a logoUrl. PNG con alpha recomendado.
  walletLogoUrl               String?
  // Logo dedicado para el banner de notificaciones push (lockscreen iPhone +
  // ícono en la lista de la app Wallet). Se usa SOLO para el icon.png del
  // .pkpass — el logo.png del header del pase abierto sigue usando
  // walletLogoUrl/logoUrl, así que el diseño visual del pase no cambia.
  // Fallback: pushLogoUrl → walletLogoUrl → logoUrl. Cuadrado recomendado.
  pushLogoUrl                 String?
  primaryColor                String                     @default("#22C55E")
  secondaryColor              String                     @default("#15803D")
  status                      TenantStatus               @default(TRIAL)
  /// Si true, el tenant está en modo demo bloqueado: cualquier usuario
  /// que NO sea SUPER_ADMIN puede ver el panel y navegar pero no puede
  /// modificar nada (POST/PATCH/PUT/DELETE rechazados con 423 Locked).
  /// Pensado para crear cuentas demo que los embajadores logean y muestran
  /// a prospects sin riesgo de que toquen el contenido curado.
  isLocked                    Boolean                    @default(false)
  lockedAt                    DateTime?
  lockedReason                String?                    @db.Text
  // Categoría del rubro (restaurante, autolavado, barbería, etc.) — define
  // qué módulos del panel ve el dueño. Lista en common/business-categories.ts.
  // Nullable por compat con tenants viejos; en runtime cae a 'restaurant'.
  businessCategorySlug        String?
  planId                      String
  plan                        Plan                       @relation(fields: [planId], references: [id])
  // Periodicidad del plan (MENSUAL|TRIMESTRAL|SEMESTRAL|ANUAL). NO afecta
  // billing real (ese lo dicta Hotmart). Solo se usa para CRM / reporting
  // / filtros en /admin/tenants. Nullable porque tenants pre-2026-06-04
  // no la tienen seteada.
  planPeriodicity             String?
  // 2026-06-15: precio REAL que el cliente pagó en Hotmart por su ciclo
  // (payload.data.purchase.price.value). Es la FUENTE DE VERDAD para la
  // base de comisiones — el socio 10%, la directa y la indirecta se
  // calculan sobre este monto. Nullable: tenants viejos no lo tienen y
  // caen al precio canónico del bundle (getBundlePrice). Crítico para el
  // legacy del link de $50 (esos negocios pagaron 50, no 68): al setearlo
  // (auto desde webhook o manual desde /admin/tenants) las comisiones
  // dejan de sobre-estimarse.
  subscriptionPriceUsd        Decimal?                   @db.Decimal(10, 2)
  // M4 (2026-06-04): override del rate-limit "1 sello cada 24h" por pass.
  // null = 1 (default histórico). N >= 1 permite hasta N sellos/pass/día.
  // El bypass SUPER_ADMIN sigue intacto. Pensado para campañas
  // promocionales (cumpleaños, evento, doble sello, etc).
  maxStampsPerDay             Int?
  maxLocationsOverride        Int?
  // Bloque 2 (2026-06-12): toggles per-tenant para mostrar/ocultar
  // los links de Tutoriales (sidebar TENANT_OWNER) y Academia Clubify
  // (sidebar afiliados). Default true — el negocio los ve a menos que
  // SUPER_ADMIN lo apague desde /admin/tenants/[id].
  tutorialsEnabled            Boolean                    @default(true)
  academyEnabled              Boolean                    @default(true)
  /// Reservations module 2026-06-12. Default OFF — el SUPER_ADMIN lo
  /// activa por tenant. Cuando false el sidebar oculta el módulo y el
  /// endpoint público /reserva/:slug devuelve 404.
  reservationsEnabled         Boolean                    @default(false)
  /// Reservas de SERVICIOS (citas). PDF245 P7 — distinto de reservas de mesa.
  /// Se activa por negocio desde Master Admin / panel de marca (módulo
  /// SERVICE_RESERVATIONS). false = oculto en el panel y público 404.
  serviceReservationsEnabled  Boolean                    @default(false)
  /// Horarios disponibles para reservas online (HH:MM 24h, ej. ["13:00","13:30","21:00"]).
  /// Si vacío, el backend cae al default histórico (turnos almuerzo + cena).
  /// El frontend público los muestra en formato 12h (1:00 p.m.) automáticamente.
  reservationSlots            String[]                   @default([])
  // Bloque 5 (2026-06-12): soft-delete con "conservar historial".
  // Si está seteado, el tenant queda inaccesible (no aparece en list/
  // login) pero las relaciones (Order/Commission/ReferralUse) se
  // preservan para auditoría contable. Hard delete sigue siendo
  // posible vía DELETE (cascade) eligiendo "eliminar todo" en el modal.
  deletedAt                   DateTime?
  referredByCode              String?
  currency                    String                     @default("COP")
  /// Override opcional del símbolo monetario. Si está null, se usa el
  /// símbolo automático de Intl según la moneda (COP → "$", EUR → "€").
  /// Útil para Bs, Ref., Pts o símbolos custom. Max 8 caracteres.
  currencySymbol              String?
  /// País del negocio (ISO 3166-1 alpha-2, ej: "CO", "MX", "AR"). Usado
  /// para resolver el dropdown dinámico de estados/provincias y para
  /// defaults locale-aware.
  country                     String                     @default("CO")
  timezone                    String                     @default("America/Bogota")
  /// Idioma del NEGOCIO (PDF 1254): maneja el panel y el default del
  /// storefront/clientes. Cada negocio es independiente. Valores: es|en|pt|it
  /// (o variantes en-GB/en-US/pt-BR). Default 'es'.
  locale                      String                     @default("es")
  instagramUrl                String?
  facebookUrl                 String?
  mapsUrl                     String?
  // Override del label de sección principal ("Menú", "Servicios" o custom
  // tipo "Tratamientos"). Si null, se infiere de businessCategorySlug.
  // Editable por el dueño en /app/settings. Solo afecta texto visible —
  // los slugs internos siguen siendo "menu".
  mainSectionLabelOverride    String?
  // Trial público (registro vía /prueba o /trial). Captura intent del
  // prospect. trialSource: LANDING|AMBASSADOR|INFLUENCER|CAMPAIGN|DIRECT
  // (texto libre — el frontend restringe). Usado por /admin/trials para
  // filtrar y métricas por canal de adquisición. La atribución a un
  // ReferralCode específico va por ReferralUse como en signup normal.
  trialSource                 String?
  // Campos opcionales que el prospect llena en el form de /prueba.
  // Sirven al equipo comercial para hacer follow-up.
  trialCompany                String?
  trialCity                   String?
  // Tracking de recordatorios SMS internos al equipo (Javier+Jhon) cuando
  // un trial está a 5/3/1/0.5 días de expirar. Idempotencia: cada
  // threshold se envía 1 vez. Valor: "5"|"3"|"1"|"h12"|"expired".
  trialReminderLastSent       String?
  // Trial / billing
  trialStartedAt              DateTime?
  trialEndsAt                 DateTime?
  // Días extra después de trialEndsAt antes de suspender (editable por super admin).
  gracePeriodDays             Int                        @default(0)
  currentPeriodEnd            DateTime?
  hotmartSubscriberCode       String?
  hotmartTransactionId        String?
  /// Stripe (marcas con paymentGateway=STRIPE): customer + subscription para
  /// matchear renovaciones del webhook (análogo a hotmartSubscriberCode).
  stripeCustomerId            String?
  stripeSubscriptionId        String?
  failedPaymentCount          Int                        @default(0)
  lastPaymentAttemptAt        DateTime?
  // E (2026-06-12): timestamp del último pago aprobado real (approved_date
  // del payload Hotmart). Útil para reportes y debugging — antes solo
  // teníamos currentPeriodEnd que es el PRÓXIMO cobro.
  lastChargeAt                DateTime?
  suspendedAt                 DateTime?
  // Tracking de notificaciones de cobro automáticas (idempotencia del cron):
  // - paymentReminderSentFor: igualamos a currentPeriodEnd cuando ya
  //   enviamos el "tu cobro es mañana". Evita re-enviar si el cron corre
  //   2 veces el mismo día.
  // - paymentFailureNoticeSentAt: cuándo se envió el último "tu pago
  //   falló". Re-envía si lastPaymentAttemptAt avanza.
  // - pausePendingNoticeSentAt: cuándo se envió el "tu cuenta se pausará
  //   en 2 días". Solo una vez por ciclo de fallos.
  paymentReminderSentFor      DateTime?
  paymentFailureNoticeSentAt  DateTime?
  pausePendingNoticeSentAt    DateTime?
  // Serie pre-cobro (PDF734): idempotencia por ciclo de los recordatorios
  // amables "7 días antes" y "mismo día del cobro". Igualamos a
  // currentPeriodEnd al enviar, para no repetir si el cron corre 2 veces.
  preReminder7dSentFor        DateTime?
  preReminderTodaySentFor     DateTime?
  // Cuándo el dueño cerró el popup de bienvenida ("agendar sesión
  // personalizada"). Si null, todavía no lo vio → se le muestra al
  // entrar al panel. Para tenants que ya existían se backfilllea con
  // createdAt en la migración.
  welcomePopupSeenAt          DateTime?
  // Onboarding chain (después del welcome popup):
  // - businessAddressOnboardedAt: marcó el paso de "dirección del negocio"
  //   (creó una Location o le dio Saltar)
  // - businessCategoryOnboardedAt: marcó el paso de "categoría del rubro"
  //   (eligió una de BUSINESS_CATEGORIES o le dio Saltar)
  businessAddressOnboardedAt  DateTime?
  businessCategoryOnboardedAt DateTime?
  // Integración Grow Business (proveedor externo de SMS, conectado por super admin)
  growBusinessLocationId      String?
  growBusinessApiKey          String?
  growBusinessConnectedAt     DateTime?
  /// Número de "Switch" que Grow Business usa para enrutar el mensaje
  /// al sub-account correcto. Se prepone al body como "#Switch{N}\n\n".
  /// Cada tenant tiene su propio número (1, 2, 3, ...). Null = no se
  /// prepone prefijo (mensaje plano).
  growBusinessSwitchNumber    Int?
  /// Alertas SMS por reseñas negativas (1-3 ⭐). Si enabled=true y
  /// Grow Business está conectado (o hay reviewAlertsAccountId apuntando
  /// a una subcuenta global), al recibir una reseña con rating <=
  /// threshold se envía un SMS al teléfono configurado (o al owner
  /// fallback) con el detalle del feedback. Aditivo — los tenants
  /// existentes quedan con enabled=false hasta configurarlo.
  reviewAlertsEnabled         Boolean                    @default(false)
  /// Rating umbral inclusive. Default 3 = dispara para 1, 2 y 3 ⭐.
  /// Si bajás a 2, solo 1 y 2 ⭐ disparan.
  reviewAlertsThreshold       Int                        @default(3)
  /// Teléfono destino del SMS. Null = usa fallback (owner.phone →
  /// whatsappPhone → phone). Útil para mandar la alerta a un encargado
  /// distinto del owner registrado.
  reviewAlertsPhone           String?
  /// Plantilla del SMS con tokens {businessName} {customerName}
  /// {customerPhone} {rating} {feedback} {date} {feedbackUrl}. Null =
  /// usa la plantilla default del backend.
  reviewAlertsTemplate        String?
  /// Subcuenta global compartida para enviar las alertas SMS de
  /// reseñas. Cuando está seteado, se usan esas credenciales en lugar
  /// de las growBusiness* del propio tenant. Permite que el super
  /// admin conecte UNA subcuenta y la asigne a múltiples negocios.
  /// Null = usa creds del tenant directo (comportamiento legacy).
  reviewAlertsAccountId       String?
  reviewAlertsAccount         GrowBusinessAccount?       @relation("ReviewAlertsAccount", fields: [reviewAlertsAccountId], references: [id], onDelete: SetNull)
  /// SMS administrativos (recordatorios de pago, impago, suspensión).
  /// Default true para no romper comportamiento legacy — billing
  /// siempre venía mandando. El owner lo puede apagar desde su panel.
  billingAlertsEnabled        Boolean                    @default(true)
  /// Teléfono destino del SMS de billing. Null = fallback (owner.phone
  /// → whatsappPhone → phone), igual que antes.
  billingAlertsPhone          String?
  /// Subcuenta global compartida para SMS de billing. Misma idea que
  /// reviewAlertsAccountId pero para mensajes administrativos. Null =
  /// fallback a credenciales propias del tenant (legacy).
  billingAlertsAccountId      String?
  billingAlertsAccount        GrowBusinessAccount?       @relation("BillingAlertsAccount", fields: [billingAlertsAccountId], references: [id], onDelete: SetNull)
  /// SMS automáticos a empresas de domicilio cuando un pedido delivery
  /// cambia de estado. Default false (feature opt-in — sino spamearíamos
  /// a tenants existentes que no la pidieron).
  deliveryAlertsEnabled       Boolean                    @default(false)
  /// Array JSON de teléfonos destino. Permite mandar la misma alerta a
  /// varias empresas/personas en paralelo. Cuando no hay nada, se cae
  /// al whatsappDeliveryPhone histórico si está configurado.
  /// Ejemplo: ["+57 300 111 1111", "+57 300 222 2222"].
  deliveryAlertsPhones        Json?
  /// Eventos del pedido delivery que disparan SMS. Valores: 'created',
  /// 'confirmed', 'ready', 'delivered'. Default ['created'] cuando
  /// enabled=true. JSON array.
  deliveryAlertsEvents        Json?
  /// Subcuenta global compartida para SMS de delivery. Mismo patrón
  /// que review/billing. Null = creds del tenant.
  deliveryAlertsAccountId     String?
  deliveryAlertsAccount       GrowBusinessAccount?       @relation("DeliveryAlertsAccount", fields: [deliveryAlertsAccountId], references: [id], onDelete: SetNull)
  /// Cuponera / Living Card: true si este tenant es el "de sistema" que
  /// respalda una campaña de beneficios (BenefitCampaign). Se EXCLUYE de
  /// métricas del panel, cobros/mora y listados de negocios — no es un
  /// negocio real, solo hospeda Customer(miembros)/Card/Location/Pass.
  isCampaignHost              Boolean                    @default(false)
  createdAt                   DateTime                   @default(now())

  users                   User[]
  cards                   Card[]
  customers               Customer[]
  passes                  Pass[]
  locations               Location[]
  stamps                  Stamp[]
  walletNotifications     Notification[]
  recurringNotifications  RecurringNotification[]
  reservationZones        ReservationZone[]
  reservationTables       ReservationTable[]
  reservations            Reservation[]
  reservationEvents       ReservationEvent[]
  eventAttendees          EventAttendee[]
  automations             AutomationRule[]
  referralUses            ReferralUse[]
  categories              Category[]
  products                Product[]
  adicionales             Adicional[]
  carts                   Cart[]
  orders                  Order[]
  promotions              Promotion[]
  channelConfigs          ChannelConfig[]
  messages                Message[]
  templates               MessageTemplate[]
  storefront              Storefront?
  menuBookSections        MenuBookSection[]
  infoLinks               InfoLink[]
  events                  Event[]
  reviewFeedbacks         ReviewFeedback[]
  reviewQrTargets         ReviewQrTarget[]
  reminders               Reminder[]
  suppliers               Supplier[]
  frequentProducts        FrequentProduct[]
  purchaseOrders          PurchaseOrder[]
  badges                  Badge[]
  qrPosters               QrPoster[]
  menuTranslations        MenuTranslation[]
  // Cotizaciones que se convirtieron en este tenant (closed-loop signup
  // con qt=<publicToken> en el URL).
  fromQuotes              Quote[]                  @relation("QuoteConvertedToTenant")
  // Item 6 sprint: excepciones de comisión configuradas para este tenant
  // (1 por nivel de la cadena: influencer/embajador/vendedor).
  commissionExceptions    CommissionException[]
  // Red de Domicilios (Fase 1, 2026-06-29): empresas habilitadas para este
  // negocio + seguimientos logísticos de sus pedidos.
  deliveryCompanyLinks    DeliveryCompanyTenant[]
  deliveries              Delivery[]
  deliveryCompanyMessages DeliveryCompanyMessage[]
  // Cuponera / Living Card: campaña que respalda este tenant (1:1, solo si
  // isCampaignHost=true).
  benefitCampaign         BenefitCampaign?

  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

/// Pago de Hotmart recibido por webhook ANTES de que exista la cuenta
/// (flujo "pago → datos" del referido). El webhook lo guarda cuando no
/// matchea ningún tenant; /auth/signup lo consume al crear la cuenta y
/// activa el tenant al instante reusando la activación del webhook (por
/// tenantId). Evita perder pagos por la carrera webhook-vs-signup, y
/// soporta recuperación (SMS/email al comprador que pagó y no volvió).
model PendingHotmartPayment {
  id                 String    @id @default(uuid())
  /// Email del comprador (lowercased) — clave de match con el signup.
  email              String
  subscriberCode     String?
  transactionId      String?
  /// PURCHASE_APPROVED | PURCHASE_COMPLETE
  event              String
  /// Payload completo del webhook para re-ejecutar la activación.
  rawPayload         Json
  /// Cuándo se consumió (cuenta creada + activada). null = pendiente.
  consumedAt         DateTime?
  /// Cuándo se envió el SMS/email de recuperación al comprador.
  recoveryNotifiedAt DateTime?
  /// Cuándo se envió el SMS de recordatorio al equipo (founder) porque
  /// el comprador no completó /activar en 1h+. Idempotente — el cron
  /// no re-envía si este campo ya tiene valor (2026-06-12).
  teamReminderSentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
  @@index([consumedAt])
  @@index([teamReminderSentAt])
}

/// E (2026-06-12): event-level idempotency para el webhook Hotmart.
/// Antes la dedup era solo por externalTxId en Commission (caso por caso).
/// Ahora cada webhook event que llega registra su id + type en esta tabla;
/// si el id ya existe, se ignora — Hotmart reintenta con el MISMO id.
///
/// eventId viene del campo `id` del payload Hotmart cuando existe, o
/// un hash determinístico de (eventType + transactionId + subscriber)
/// como fallback.
model HotmartWebhookEvent {
  id          String   @id @default(uuid())
  /// Identificador único del evento Hotmart (campo `id` del payload o
  /// hash determinístico). UNIQUE — segundo INSERT del mismo evento falla.
  eventId     String   @unique
  eventType   String
  /// Tenant resuelto (puede ser null si fue PendingHotmartPayment).
  tenantId    String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([tenantId, eventType, processedAt])
}

/// Pago de Stripe recibido por webhook ANTES de que exista la cuenta
/// (flujo "pago → datos"). Análogo a PendingHotmartPayment. /auth/signup lo
/// consume al crear la cuenta (match por email) y activa el tenant. Aislado
/// por whiteLabelId: el consume solo matchea pendientes de la misma marca.
model PendingStripePayment {
  id                   String    @id @default(uuid())
  /// Email del comprador (lowercased) — clave de match con el signup.
  email                String
  whiteLabelId         String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  /// Tipo de evento Stripe (checkout.session.completed | invoice.paid).
  event                String
  /// Payload completo del evento para re-ejecutar la activación.
  rawPayload           Json
  consumedAt           DateTime?
  recoveryNotifiedAt   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
  @@index([whiteLabelId])
  @@index([consumedAt])
}

/// Idempotencia del webhook Stripe (análogo a HotmartWebhookEvent). Stripe
/// reintenta con el MISMO event.id; si ya existe, se ignora.
model StripeWebhookEvent {
  id           String   @id @default(uuid())
  /// event.id de Stripe (evt_...). UNIQUE — segundo INSERT del mismo falla.
  eventId      String   @unique
  eventType    String
  whiteLabelId String?
  tenantId     String?
  payload      Json
  processedAt  DateTime @default(now())

  @@index([whiteLabelId, eventType, processedAt])
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  // 2FA TOTP. Habilitado obligatoriamente para SUPER_ADMIN; opcional para
  // TENANT_OWNER/STAFF. `totpSecret` es el secret base32; `totpEnabledAt`
  // se setea sólo después de que el usuario confirma con un código válido.
  totpSecret        String?
  totpEnabledAt     DateTime?
  // Timestamp del último cambio de password. Usado para forzar logout
  // global: cualquier token emitido antes de esta fecha queda inválido.
  passwordChangedAt DateTime?
  // Marca cuándo se le envió la alerta SMS de preregistro al equipo
  // (PreregAlertsService). Evita doble envío si el cron de reintentos
  // re-procesa este user. null = sin alerta enviada (todavía o nunca).
  preregAlertedAt   DateTime?
  // 2026-06-12: preferencia de idioma de UI ('es' | 'en' | 'pt'). null =
  // detectar dinámicamente (browser Accept-Language → IP geo → ES).
  // Cuando el user lo elige manualmente, se persiste acá; en el resto
  // de devices el cookie NEXT_LOCALE actúa como fallback de sesión.
  preferredLocale   String?

  stampsOperated      Stamp[]              @relation("operator")
  referralCodes       ReferralCode[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  reminders           Reminder[]           @relation("ReminderEmployee")
  quotesCreated       Quote[]              @relation("QuoteAdvisor")
  // CRM (C1): cada user afiliado tiene su propio pipeline. 1:1 por ahora;
  // en C4 puede haber pipelines de equipos compartidos como relación
  // separada.
  pipeline            Pipeline?
  // CRM (C2): contactos propios del afiliado. onDelete Cascade en
  // CrmContact → si se elimina el User, los contactos también.
  crmContacts         CrmContact[]
  // CRM (C4): equipos de ventas. Un user puede ser lead de varios
  // equipos (relación 1:N) y miembro de varios equipos (relación N:M
  // via SalesTeamMember).
  salesTeamsAsLead    SalesTeam[]          @relation("SalesTeamLead")
  salesTeamMembers    SalesTeamMember[]    @relation("SalesTeamMember")
  // CRM (C5): botones automáticos configurados por el afiliado.
  crmButtons          CrmButton[]          @relation("CrmButtonOwner")
  // CRM (C6): actividades registradas por el user (historial de
  // contactos). userId apunta al que disparó la acción.
  crmActivities       CrmActivity[]        @relation("CrmActivityUser")
  // CRM (C7): conexión personal a Grow Business para sync de contactos.
  // Cada afiliado conecta su propia subcuenta. apiKey se guarda plain
  // por ahora (TODO: cifrar con KMS en una iteración futura).
  crmGbLocationId     String?
  crmGbApiKey         String?
  crmGbLocationName   String? // cache del nombre para UI
  crmGbConnectedAt    DateTime?
  crmGbLastSyncAt     DateTime?
  crmGbLastSyncCount  Int?

  // Secuencias / Automatizaciones (F2): el afiliado puede definir sus
  // propias secuencias y un step puede asignar contactos a otro user.
  sequences               Sequence[]     @relation("SequenceOwner")
  sequenceStepsAsAssignee SequenceStep[] @relation("SequenceStepAssignee")

  // Item 6 sprint: excepciones de comisión por cliente — quién las creó
  // y quién las editó (audit). Ambas son SetNull, no Cascade, para no
  // perder el historial si se elimina al admin que las hizo.
  commissionExceptionsCreated CommissionException[]        @relation("CommissionExceptionCreator")
  commissionExceptionsChanged CommissionExceptionHistory[] @relation("CommissionExceptionHistoryChanger")

  // Clubify Lab (item 13 sprint): propuestas de comunidad. Cada user
  // puede crear propuestas, votar y comentar. SUPER_ADMIN/MARKETING
  // también figuran en lastStatusChangedBy cuando mueven el status.
  labProposals        LabProposal[] @relation("LabProposalAuthor")
  labProposalsChanged LabProposal[] @relation("LabProposalLastStatusChanger")
  labVotes            LabVote[]
  labComments         LabComment[]  @relation("LabCommentAuthor")

  // Difusión interna (Broadcasts): SUPER_ADMIN crea piezas dirigidas a
  // equipos comerciales; cada user registra qué piezas leyó.
  broadcastsCreated Broadcast[]     @relation("BroadcastCreator")
  broadcastReads    BroadcastRead[]

  // Fase D 2026-06-07: sistema de pago de comisiones.
  paymentProfile         PaymentProfile?
  paymentProfilesChanged PaymentProfile[]   @relation("PaymentProfileReviewer")
  commissionPayouts      CommissionPayout[] @relation("CommissionPayoutRecipient")
  commissionPayoutsPaid  CommissionPayout[] @relation("CommissionPayoutPaidBy")

  // Fase F 2026-06-07: cada staff puede estar asociado a una sede.
  // Permite rankings de sellos por sede + miembro. Null = sin sede
  // asignada o aplica a todas (ej: TENANT_OWNER, SUPER_ADMIN).
  locationId String?
  location   Location? @relation("UserLocation", fields: [locationId], references: [id], onDelete: SetNull)

  // Master Admin (2026-06-13): invitaciones a otros PLATFORM_OWNERs que
  // creó este user, y la (única) invitación que aceptó si fue invitado.
  platformOwnerInvitesSent    PlatformOwnerInvite[] @relation("PlatformOwnerInviteInviter")
  platformOwnerInviteAccepted PlatformOwnerInvite[] @relation("PlatformOwnerInviteAcceptor")

  // Master Admin (2026-06-13): admins SUPER_ADMIN dedicados de una
  // marca blanca. NULL = no es admin de una marca (usuario normal).
  // Cuando un SUPER_ADMIN tiene whiteLabelId, sólo ve datos de los
  // tenants de esa marca; no necesita tenantId propio.
  whiteLabelId                  String?
  whiteLabel                    WhiteLabel?             @relation("WhiteLabelAdmin", fields: [whiteLabelId], references: [id], onDelete: SetNull)
  whiteLabelAdminInvitesSent    WhiteLabelAdminInvite[] @relation("WhiteLabelAdminInviteInviter")
  whiteLabelAdminInviteAccepted WhiteLabelAdminInvite[] @relation("WhiteLabelAdminInviteAcceptor")

  // Red de Domicilios — Fase 2 (2026-06-30): cuenta de una empresa de
  // domicilios (role=DELIVERY_COMPANY). NULL = usuario normal. Su portal ve
  // solo los domicilios de su empresa.
  deliveryCompanyId String?
  deliveryCompany   DeliveryCompany? @relation("DeliveryCompanyAdmin", fields: [deliveryCompanyId], references: [id], onDelete: SetNull)

  // Cuponera / Living Card — Fase 2: cuenta de un negocio aliado
  // (role=ALLY_BUSINESS). NULL = usuario normal. Su portal gestiona su ficha.
  allyBusinessId String?
  allyBusiness   AllyBusiness? @relation("AllyBusinessAdmin", fields: [allyBusinessId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([role])
  @@index([locationId])
  @@index([whiteLabelId])
  @@index([deliveryCompanyId])
  @@index([allyBusinessId])
}

model Customer {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String?
  phone      String?
  fullName   String
  birthday   DateTime? @db.Date
  externalId String?
  // Idioma elegido por el cliente al enrolarse (es|en|pt|it). Se usa para
  // localizar el pase de wallet (Apple/Google). Default 'es' → clientes
  // existentes no cambian. (PDF 854)
  locale     String    @default("es")

  // Extended for v2
  firstOrderAt      DateTime?
  lastOrderAt       DateTime?
  totalOrdersCount  Int       @default(0)
  totalOrdersAmount Decimal   @default(0) @db.Decimal(12, 2)
  tags              String[]
  notes             String?   @db.Text
  marketingOptIn    Boolean   @default(true)
  whatsappVerified  Boolean   @default(false)

  // Gamificación. xpPoints acumulan por scan/redención; level se calcula
  // a partir del XP en backend (Bronce 0+, Plata 100+, Oro 300+, Platino
  // 600+, Diamante 1000+ por defecto). currentStreakDays cuenta días
  // consecutivos con al menos 1 scan; lastVisitDay (YYYY-MM-DD) se usa
  // para detectar si el streak se cortó.
  xpPoints          Int     @default(0)
  currentLevel      Int     @default(1)
  currentStreakDays Int     @default(0)
  longestStreakDays Int     @default(0)
  lastVisitDay      String?

  createdAt DateTime @default(now())

  passes              Pass[]
  stamps              Stamp[]
  carts               Cart[]
  orders              Order[]
  messages            Message[]
  notifications       Notification[]
  badges              CustomerBadge[]
  reservations        Reservation[]
  eventAttendees      EventAttendee[]
  // Cuponera / Living Card: membresías de este cliente (cuando el tenant es
  // el "de sistema" de una campaña). Un Customer normal no tiene ninguna.
  livingMemberships   LivingMembership[]
  cuponeraRedemptions Redemption[]
  cuponeraStampCards  StampCard[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ============================================================
//                       RESERVAS (2026-06-12)
// ============================================================

/// Zona del salón (Salón principal, Terraza, Barra, Privado, etc).
/// Las mesas se agrupan por zona en el plano y en los filtros del
/// flujo público de reserva. type sirve para iconos/UX, no para lógica.
model ReservationZone {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Multi-sede (2026-06-12): si null = todas las sedes / single-location tenant.
  locationId   String?
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name         String
  slug         String
  /// INDOOR | OUTDOOR | BAR | PRIVATE — para UX en el flujo público.
  type         String             @default("INDOOR")
  position     Int                @default(0)
  /// Geometría EXPLÍCITA del recuadro de la zona en el plano (modo editor).
  /// NULL = "auto": el recuadro se deriva de las posiciones de las mesas
  /// (computeZoneBox en el frontend). Cuando el dueño mueve/redimensiona la
  /// zona, se guardan estas coordenadas y dejan de depender de las mesas.
  posX         Int?
  posY         Int?
  width        Int?
  height       Int?
  isActive     Boolean            @default(true)
  tables       ReservationTable[]
  reservations Reservation[]
  createdAt    DateTime           @default(now())

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([locationId])
}

/// Mesa física del salón. Tiene posición/forma para el plano interactivo.
/// shape: ROUND (default) | RECT | BAR. Si shape != ROUND, width/height
/// vienen del editor; en ROUND se calculan desde seats.
model ReservationTable {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  zoneId       String?
  zone         ReservationZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  /// Multi-sede (2026-06-12): denormalizado de zone.locationId pero opcional
  /// permite mesas sin zona en una sede específica.
  locationId   String?
  location     Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Etiqueta visible al cliente y al admin. Puede ser número "1", "12" o texto "Barra", "VIP".
  number       String
  seats        Int              @default(4)
  shape        String           @default("ROUND")
  posX         Int              @default(0)
  posY         Int              @default(0)
  width        Int?
  height       Int?
  /// Bloqueada fuera de servicio (mantenimiento, reservada por evento).
  /// No aparece como disponible para clientes ni para la auto-asignación.
  isBlocked    Boolean          @default(false)
  isActive     Boolean          @default(true)
  reservations Reservation[]
  createdAt    DateTime         @default(now())

  @@index([tenantId, isActive])
  @@index([zoneId])
  @@index([locationId])
}

/// Reserva del cliente. Se crea desde el flujo público (sin auth, throttled)
/// o desde el admin. customerId se enlaza si existe Customer con el mismo
/// phone (findOrCreate), sino queda null y los datos viven en
/// customerName/customerPhone/customerEmail. Cuando el admin confirma se
/// puede asignar tableId/zoneId opcionalmente.
model Reservation {
  id         String            @id @default(uuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Multi-sede (2026-06-12). Tipicamente heredado de zone.locationId al crear.
  locationId String?
  location   Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  zoneId     String?
  zone       ReservationZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  tableId    String?
  table      ReservationTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?
  party         Int
  /// Día de la reserva en UTC mediodía (12:00) para evitar drift de TZ.
  date          DateTime
  /// Hora local en formato HH:MM 24h (combinada con tenant.timezone si existe).
  time          String
  notes         String?  @db.Text

  status  ReservationStatus  @default(PENDING)
  channel ReservationChannel @default(WEB)

  /// Marca cuando el equipo confirmó manualmente con el cliente.
  confirmedAt DateTime?
  seatedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  /// Idempotency del WhatsApp al negocio — si llegan 2 webhooks del mismo
  /// botón "Crear reserva" del flujo público no avisamos 2 veces.
  notifiedAt DateTime?

  /// Recordatorio SMS/WhatsApp al cliente 24h antes de la reserva.
  /// El cron lo claimea atómicamente al disparar para evitar dobles envíos.
  reminderSentAt DateTime?

  /// Cuándo se otorgó el sello de fidelización al cliente por esta reserva.
  /// Claim atómico al transicionar a SEATED para evitar doble-sello en
  /// caso de re-status changes. Null = todavía no recibió sello.
  stampGrantedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, date, status])
  @@index([tableId])
  @@index([customerId])
  @@index([reminderSentAt, status])
  @@index([locationId, date])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationChannel {
  WEB
  WHATSAPP
  PHONE
  QR
  IN_PERSON
}

/// Eventos especiales (catas, conciertos, cenas, eventos privados) que
/// el negocio organiza fuera del flujo normal de reservas por mesa.
/// Tienen capacidad fija (en lugar de mesas), horario start/end y
/// pueden tener precio. Los clientes se registran via attendees.
model ReservationEvent {
  id            String          @id @default(uuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locationId    String?
  location      Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name          String
  description   String?         @db.Text
  coverImageUrl String?
  /// Fecha del evento en UTC mediodía (mismo patrón que Reservation.date).
  date          DateTime
  /// Hora de inicio HH:MM 24h (local del tenant).
  startTime     String
  /// Hora estimada de fin HH:MM 24h.
  endTime       String
  /// Cupo máximo de asistentes.
  capacity      Int
  /// Precio del evento (opcional). Si null, es gratis.
  price         Decimal?        @db.Decimal(12, 2)
  priceCurrency String          @default("MXN")
  status        EventStatus     @default(DRAFT)
  attendees     EventAttendee[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId, date, status])
  @@index([locationId])
}

/// Asistente registrado a un evento. Equivalente a Reservation pero
/// scoped al evento — no usa table/zone porque la capacidad es global
/// del evento, no por mesa.
model EventAttendee {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventId       String
  event         ReservationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  customerEmail String?
  /// Cantidad de personas que asisten bajo este registro (ej. 2 entradas).
  party         Int              @default(1)
  notes         String?          @db.Text
  status        AttendeeStatus   @default(CONFIRMED)
  checkInAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([eventId])
  @@index([tenantId])
  @@index([customerId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum AttendeeStatus {
  CONFIRMED
  CHECKED_IN
  CANCELLED
  NO_SHOW
}

// ============================================================
//                       LOYALTY (v1)
// ============================================================

model Card {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type                CardType
  name                String
  // #24 (2026-06-16): nombre de marca a mostrar EN EL PASE (Apple logoText/
  // organizationName, Google issuerName/header). Si null, cae al
  // Tenant.brandName. Permite que cada tarjeta muestre un nombre propio sin
  // cambiar el nombre del negocio que ve el dashboard.
  walletBrandName     String?
  description         String    @default("")
  terms               String    @default("")
  // Si false, el reverso de la wallet no muestra T&C (el dueño los
  // apagó porque no son obligatorios para su negocio).
  termsEnabled        Boolean   @default(true)
  primaryColor        String    @default("#22C55E")
  secondaryColor      String    @default("#15803D")
  // Colores avanzados — opcionales. Si null, el .pkpass cae a primary/secondary.
  // El picker en el wizard los expone bajo "Colores avanzados".
  stampActiveColor    String?
  stampInactiveColor  String?
  stampContourColor   String?
  centerBgColor       String?
  // Wallet V3 — fondo del ÁREA DE SELLOS (el strip generado), independiente
  // del resto del pase (header/premio/cliente/QR no se ven afectados).
  //   "GRADIENT" = legacy (degradado primary→secondary). Backfill de tarjetas
  //               existentes para no cambiar su aspecto (opt-in).
  //   "SOLID"    = color uniforme (mismo primaryColor / centerBgColor). Default
  //               de tarjetas NUEVAS.
  //   "IMAGE"    = imagen personalizada (stampBgImageUrl) detrás de los sellos.
  // Gateado por la marca (WhiteLabel.walletAdvanced.customBackgrounds).
  stampBgType         String    @default("SOLID")
  stampBgImageUrl     String?
  logoUrl             String?
  heroImageUrl        String?
  iconUrl             String?
  stampsRequired      Int?
  rewardText          String    @default("")
  pointsPerCurrency   Decimal?  @db.Decimal(10, 2)
  discountPercent     Int?
  // CASHBACK: % devuelto por compra. Compra mínima opcional para activar.
  cashbackPercent     Int?
  cashbackMinPurchase Decimal?  @db.Decimal(12, 2)
  // STAMPS/VISITS/HYBRID: monto mínimo de compra para otorgar un sello.
  // Si null, no hay restricción. Si seteado, el scanner valida
  // purchaseAmount >= minAmountPerStamp antes de incrementar.
  minAmountPerStamp   Decimal?  @db.Decimal(12, 2)
  // VISITS: cuántas visitas para canjear la recompensa (equivalente a
  // stampsRequired pero sin importar el ticket).
  visitsRequired      Int?
  // MEMBERSHIP con tiers VIP. Cada tier:
  //   { name:'Silver', threshold:0,  perks:['Acceso premium'], color:'#9CA3AF', icon:'🥈' }
  // tierMetric: spend|visits|stamps — qué métrica decide el tier.
  tiers               Json      @default("[]")
  tierMetric          String    @default("spend")
  validFrom           DateTime? @db.Date
  validUntil          DateTime? @db.Date
  // Si está seteado, cada Pass de esta tarjeta vence
  // (issuedAt + validDaysAfterIssue) días. Mutuamente excluyente con
  // validUntil: el usuario elige una de las tres modalidades en el
  // wizard (Ilimitado / Plazo definido / Plazo después de emisión).
  validDaysAfterIssue Int?
  // Tarjeta asociada a una sede del negocio (multi-sede). Null = aplica a
  // todas las sedes. Permite filtrar customers/passes por origen y saber
  // de qué sede llegó cada cliente.
  locationId          String?
  location            Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  // === Información (paso 4 del wizard, va al reverso del .pkpass) ===
  howToEarnText       String    @default("")
  businessName        String    @default("")
  rewardDescText      String    @default("")
  // Templates con [#] = sellos/puntos restantes para la próxima recompensa.
  stampEarnedMessage  String    @default("")
  rewardEarnedMessage String    @default("")
  // Hitos intermedios. Cada elemento: {at:5, reward:"5% off"}.
  // Si vacío, solo hay recompensa al alcanzar stampsRequired.
  multiRewards        Json      @default("[]")
  // Wallet V3 — "Premios Free": premios intermedios configurables (ilimitados)
  // que se dibujan DENTRO del círculo del sello en su posición. Cada elemento:
  //   { id:string, pos:int, text:string(≤2 palabras), emoji?:string,
  //     circleColor?:hex, textColor?:hex, active:boolean }
  // Más rico que multiRewards (que solo dispara un push). Alimenta el círculo
  // premium + el cálculo dinámico de "Próximo Premio". Gateado por la marca
  // (WhiteLabel.walletAdvanced.freeRewards).
  freeRewards         Json      @default("[]")
  // Enlaces que el cliente puede tocar desde el reverso del pass.
  // Cada elemento: {type:'URL'|'PHONE'|'EMAIL'|'ADDRESS', url:string, label:string}.
  activeLinks         Json      @default("[]")
  socialLinks         Json      @default("{}")
  googleClassId       String?
  isActive            Boolean   @default(true)
  // COUPON/DISCOUNT/GIFT: id de la Card de STAMPS destino a la que se
  // transforma este cupón al hacer REDEEM. null = comportamiento auto
  // (usar la primera STAMPS card activa del tenant, o crearla si no
  // existe). El dueño elige el destino explícito en el wizard de
  // creación del cupón. SetNull si la stamps card destino se elimina —
  // el cupón cae al modo "auto" en lugar de romperse.
  transformIntoCardId String?
  transformIntoCard   Card?     @relation("CouponTransformTarget", fields: [transformIntoCardId], references: [id], onDelete: SetNull)
  // Relación inversa (cards que apuntan a esta como destino del transform).
  transformedFrom     Card[]    @relation("CouponTransformTarget")
  // v2: si está activa la integración orders→sello
  autoStampOnOrder    Boolean   @default(true)
  autoStampAmount     Int       @default(1)
  // Emoji que se usa para representar cada sello visualmente (☕, 🍕, 🍔, etc).
  // El cliente lo elige al crear la tarjeta.
  stampIcon           String    @default("☕")
  createdAt           DateTime  @default(now())

  passes                  Pass[]
  notifications           Notification[]
  recurringNotifications  RecurringNotification[]
  utmLinks                CardUtmLink[]
  popupForStorefronts     Storefront[]            @relation("StorefrontPopupCard")
  // M9: Card como CTA de popups del Menú Libro (global + por sección + por página).
  bookPopupForStorefronts Storefront[]            @relation("StorefrontBookPopupCard")
  popupForBookSections    MenuBookSection[]       @relation("MenuBookSectionPopupCard")
  popupForBookPages       MenuBookPage[]          @relation("MenuBookPagePopupCard")

  @@index([tenantId])
  @@index([locationId])
}

// Enlace UTM por canal (Facebook, IG, TikTok, etc.) que entrega bonus
// de bienvenida al cliente que se inscribe vía ese link. Permite saber
// de qué campaña llegó cada pass.
model CardUtmLink {
  id             String    @id @default(uuid())
  cardId         String
  card           Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  // Texto libre — "Facebook campaña navideña", "IG influencer X".
  source         String
  // Slug corto para construir el link público /c/u/{slug}.
  slug           String    @unique
  welcomeStamps  Int?
  welcomePoints  Decimal?  @db.Decimal(12, 2)
  // Hasta cuándo el bonus de bienvenida sigue activo (null = sin tope).
  bonusExpiresAt DateTime?
  useCount       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([cardId])
}

model Pass {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardId            String
  card              Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serialNumber      String          @unique
  qrToken           String          @unique
  /// Tokens QR ANTERIORES de este pass (o de pases fusionados en este). El
  /// scanner también resuelve por acá para que un código ya instalado en la
  /// billetera del cliente NUNCA deje de escanear, aunque el pass se haya
  /// fusionado/regenerado. Ver scanner.service.findByQrToken + customers.merge.
  legacyQrTokens    String[]        @default([])
  authToken         String
  stampsCount       Int             @default(0)
  pointsBalance     Decimal         @default(0) @db.Decimal(12, 2)
  // CASHBACK: saldo en moneda acumulado en este pass.
  cashbackBalance   Decimal         @default(0) @db.Decimal(12, 2)
  // VISITS: contador de visitas registradas (acción VISIT).
  visitsCount       Int             @default(0)
  // MEMBERSHIP con tiers: nombre del tier actual + métrica acumulada
  // sobre la que se calcula el siguiente tier.
  currentTier       String?
  tierProgress      Decimal         @default(0) @db.Decimal(12, 2)
  status            PassStatus      @default(ACTIVE)
  issuedAt          DateTime        @default(now())
  lastActivityAt    DateTime?
  googleObjectId    String?
  applePassUrl      String?
  /// Platform wallet que el cliente eligió. Se setea cuando descarga el
  /// .pkpass (APPLE) o pide el save URL de Google (GOOGLE). Sirve para
  /// analytics "cuántos clientes usan Apple vs Google Wallet". Null = el
  /// cliente nunca tocó ningún endpoint de wallet (ej. solo escaneó).
  walletPlatform    WalletPlatform?
  walletInstalledAt DateTime?

  stamps        Stamp[]
  walletDevices WalletDevice[]

  @@unique([cardId, customerId])
  @@index([tenantId])
  @@index([customerId])
  // Listados/dashboards filtran por tenant + status (ACTIVE vs COMPLETED) y
  // ordenan por `issuedAt DESC`. Sin este índice el panel cargaba lento en
  // tenants con >5k passes.
  @@index([tenantId, status, issuedAt(sort: Desc)])
}

model WalletDevice {
  id              String         @id @default(uuid())
  passId          String
  pass            Pass           @relation(fields: [passId], references: [id], onDelete: Cascade)
  platform        WalletPlatform
  deviceLibraryId String
  pushToken       String
  createdAt       DateTime       @default(now())

  @@unique([passId, deviceLibraryId])
  @@index([passId])
}

model Stamp {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  passId         String
  pass           Pass        @relation(fields: [passId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  locationId     String?
  location       Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  operatorId     String?
  operator       User?       @relation("operator", fields: [operatorId], references: [id], onDelete: SetNull)
  orderId        String?
  order          Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  action         StampAction
  amount         Decimal     @default(1) @db.Decimal(10, 2)
  // Monto que el cliente pagó por la compra que motivó este scan.
  // Solo se setea para STAMP/VISIT (cards de sellos/visitas/híbridas) —
  // NO afecta cuántos sellos se otorgan (regla anti-fraude: 1 scan = 1 sello).
  // Es informativo: alimenta los KPIs de facturación, ticket promedio, ROI.
  // Para CASHBACK_ADD el "amount" YA es el saldo otorgado proporcional al
  // monto pagado, así que purchaseAmount queda null (la fórmula ya está
  // implícita: amount = purchaseAmount * cashbackPercent / 100).
  purchaseAmount Decimal?    @db.Decimal(12, 2)
  note           String?
  // Wallet V3 — auditoría de ajustes manuales de sellos (+1/-1 desde escáner).
  // "note" cumple como Motivo; estos dos completan el rastro (IP + navegador/
  // dispositivo del operador). Null para stamps automáticos (orders/webhook).
  ip             String?
  device         String?
  createdAt      DateTime    @default(now())

  @@index([passId, createdAt])
  @@index([tenantId, createdAt])
  // M6 (2026-06-04) introduce filtros por locationId y operatorId en
  // customers.findMany. Sin estos indices, queries en tenants con
  // mucho stamp histórico hacen seq scan.
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, operatorId, createdAt])
}

model Location {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  address             String   @default("")
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  radiusMeters        Int      @default(300)
  // Texto que aparece en el lock screen del iPhone cuando el cliente está
  // dentro del radio (Apple Wallet `locations[].relevantText`). Si null,
  // cae al default "Estás cerca de {brandName}".
  walletRelevantText  String?
  // #20 (2026-06-17): link EXACTO de Google Maps de esta sede (share URL del
  // lugar). Si está set, los botones "Dirección" del infolink (y otros) abren
  // exactamente este lugar en vez de una búsqueda por texto/coordenadas.
  mapsUrl             String?
  // #3 (2026-06-18): administrador de esta sede. Si una reseña queda por
  // debajo del umbral, la alerta SMS va a este teléfono (de la sede) en vez
  // del administrador general del negocio. Null = usa el destino global.
  adminName           String?
  adminPhone          String?
  // Sedes por estado (2026-06-21): estado/región de la sede → llave de ruteo
  // de pedidos de domicilio (matchea el `departamento` que elige el cliente en
  // el checkout). Null = sede sin estado (no entra al ruteo por estado).
  state               String?
  // Número de WhatsApp donde llegan los PEDIDOS de esta sede. Si null, el
  // ruteo cae a adminPhone → número de pedidos del negocio → fallback.
  ordersWhatsappPhone String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  stamps            Stamp[]
  orders            Order[]
  cards             Card[]
  reviewQrTargets   ReviewQrTarget[]
  // Fase F 2026-06-07: usuarios del tenant pueden estar asociados a una
  // sede para rankings de sellos por miembro+ubicación.
  staffUsers        User[]             @relation("UserLocation")
  // Multi-sede reservas (2026-06-12)
  reservationZones  ReservationZone[]
  reservationTables ReservationTable[]
  reservations      Reservation[]
  reservationEvents ReservationEvent[]

  @@index([tenantId])
}

model Notification {
  id          String              @id @default(uuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardId      String?
  card        Card?               @relation(fields: [cardId], references: [id])
  // Cliente DESTINATARIO cuando la notificación es individual (automations:
  // cumpleaños, inactividad, etc.). null = broadcast (a todos los pases del
  // tenant). El campo `lastMessage` del pase Apple SOLO muestra notificaciones
  // con customerId null (broadcast) o == el dueño del pase — así un cliente
  // NUNCA ve el saludo personalizado de OTRO cliente. Bug 2026-06-23.
  customerId  String?
  customer    Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  segment     Json?
  title       String
  body        String
  triggerType NotificationTrigger @default(MANUAL)
  // Si scheduledAt es null → envío inmediato. Si tiene fecha futura → el
  // cron lo despacha cuando llega. sentAt queda null hasta el envío real.
  scheduledAt DateTime?
  sentAt      DateTime?
  stats       Json                @default("{}")
  createdAt   DateTime            @default(now())

  @@index([tenantId, sentAt])
  @@index([scheduledAt])
  @@index([customerId, sentAt])
}

/// 2026-06-12: notificaciones PUSH recurrentes. A diferencia de
/// `Notification` (one-shot con scheduledAt opcional), este modelo
/// guarda una plantilla que el cron dispara N veces a la semana en
/// los días + hora configurados. Cuando dispara crea una `Notification`
/// con triggerType=SCHEDULED como audit trail del envío real.
model RecurringNotification {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardId           String?
  card             Card?     @relation(fields: [cardId], references: [id], onDelete: SetNull)
  title            String
  body             String
  segment          Json?
  /// Días de la semana en los que dispara. 0=Domingo, 1=Lunes...6=Sábado.
  /// Array vacío = configurada pero sin días → nunca dispara (defensa).
  daysOfWeek       Int[]
  /// Hora local en formato "HH:MM" 24h. Combinado con `timezone` para
  /// calcular el instante exacto. Validación en el DTO.
  timeOfDay        String
  /// IANA timezone (ej "America/Bogota"). Default al TZ del founder.
  /// Permite que un tenant en CDMX dispare a las 10am local sin que
  /// importe la hora del servidor.
  timezone         String    @default("America/Bogota")
  isActive         Boolean   @default(true)
  /// Última vez que el cron disparó esta recurrencia. Sirve como
  /// idempotency dentro del mismo día calendario en `timezone`.
  lastDispatchedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, isActive])
}

// ============================================================
//                       CATALOG (v2)
// ============================================================

model Category {
  id          String     @id @default(uuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String
  description String?
  imageUrl    String?
  /// Subtitulo opcional (~80 char) que aparece debajo del nombre en la
  /// portada de la sección. Ej: "Cortes premium importados".
  tagline     String?
  /// Config visual de la portada de la sección (banner editable tipo
  /// editor QR). Estructura: { bgImageUrl, overlay: { color, opacity },
  /// title: { color, font, weight, size, align, position }, tagline:
  /// {...}, height, template }. Si null, render usa fallback (imageUrl
  /// como bg + nombre centrado, estilo legacy).
  coverConfig Json?
  /// Popup opcional por categoría/sección del menú. Si `enabled=true`,
  /// el storefront público lo muestra (auto al entrar o al tap del
  /// banner según `trigger`). Shape:
  /// { enabled: bool, imageUrl?: string, title?: string,
  ///   description?: string, buttonText?: string, buttonUrl?: string,
  ///   buttonColor?: string, trigger: 'auto'|'click',
  ///   oncePerSession: bool }.
  /// NULL = sin popup (default histórico, NO se renderiza nada).
  popupConfig Json?
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  products Product[]

  @@unique([tenantId, parentId, slug])
  @@index([tenantId, position])
}

model Product {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// 2026-06-12 (Bloque 2 i18n batch): nullable para que tenants sin
  /// categorías creadas puedan agregar productos. Cuando la categoría
  /// se elimina, los productos quedan huérfanos (SetNull) en lugar de
  /// borrarse — el dueño decide si crearles una categoría nueva o
  /// dejarlos como "Sin categoría" en storefront.
  categoryId           String?
  category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                 String
  description          String    @default("")
  basePrice            Decimal   @db.Decimal(10, 2)
  /// Modo del precio en el storefront público:
  ///  - "FIXED" (default): muestra basePrice como precio único.
  ///  - "RANGE": muestra "Desde basePrice — hasta priceMax". Útil para
  ///    servicios variables (barbería, spa) o productos con tamaños
  ///    sin variantes formales. basePrice queda como mínimo del rango.
  priceMode            String    @default("FIXED")
  /// Precio máximo del rango. Solo se usa cuando priceMode='RANGE'.
  /// Null cuando FIXED. Si priceMode='RANGE' y priceMax es null, el
  /// frontend trata como FIXED de fallback.
  priceMax             Decimal?  @db.Decimal(10, 2)
  /// Cómo se interpreta el precio de las VARIANTES/tamaños del producto:
  ///  - "DELTA" (default): cada variante SUMA su `priceDelta` al `basePrice`
  ///    (ej. base $20 + "Grande" +$10 = $30). Comportamiento histórico.
  ///  - "ABSOLUTE": cada variante define su PRECIO PROPIO total y reemplaza
  ///    al base (ej. "Pequeña" $20, "Mediana" $30, "Grande" $40). El número
  ///    guardado en `ProductVariant.priceDelta` es el precio final, no un delta.
  /// Los extras siempre SUMAN encima del precio resultante en ambos modos.
  variantPriceMode     String    @default("DELTA")
  imageUrl             String?
  tags                 String[]
  isAvailable          Boolean   @default(true)
  /// Visibilidad en cada uno de los dos menús públicos separados:
  /// `/m/<slug>` (mesa) y `/m/<slug>/delivery`. Default true en ambos para
  /// que productos creados antes de la separación sigan apareciendo en los
  /// dos canales; el dueño los apaga manualmente desde el modal de producto.
  availableForMesa     Boolean   @default(true)
  availableForDelivery Boolean   @default(true)
  /// Marca el producto como "Recomendado". Aparece en una sección virtual
  /// arriba de las categorías en el menú público para empujar las ventas.
  isRecommended        Boolean   @default(false)
  position             Int       @default(0)
  timesOrdered         Int       @default(0)
  /// Stock disponible. NULL = sin tracking de inventario (siempre disponible).
  /// 0 = agotado, se auto-deshabilita en storefront.
  stock                Int?
  /// Umbral para alerta "stock bajo". NULL = sin alerta.
  stockAlert           Int?
  createdAt            DateTime  @default(now())

  variants ProductVariant[]
  extras   ProductExtra[]

  @@index([tenantId, categoryId, position])
}

model ProductVariant {
  id         String  @id @default(uuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupName  String  @default("Tamaño")
  name       String
  priceDelta Decimal @default(0) @db.Decimal(10, 2)
  isDefault  Boolean @default(false)
  position   Int     @default(0)
}

model ProductExtra {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal @db.Decimal(10, 2)
  maxQty      Int     @default(1)
  isAvailable Boolean @default(true)
}

/// Biblioteca de adicionales (extras compartidos) por tenant. Permite
/// importarlos rápido a productos en lugar de recrearlos cada vez.
model Adicional {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tenantId, position])
}

/// Cache de traducciones del contenido dinámico del menú (Fase 2).
/// Una fila por (entidad, campo, locale). `sourceText` es el snapshot
/// del texto fuente al momento de traducir — si el dueño edita el
/// original, el hit-cache no coincide y se vuelve a llamar a Claude.
/// `source = 'manual'` indica override del admin (Fase 4) y NO se
/// pisa por una traducción automática posterior.
model MenuTranslation {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  field      String
  locale     String
  text       String
  sourceText String
  source     String   @default("auto")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([tenantId, entityType, entityId, field, locale])
  @@index([tenantId, locale])
}

// ============================================================
//                       ORDERS (v2)
// ============================================================

model Cart {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  sessionId     String
  items         Json       @default("[]")
  subtotal      Decimal    @default(0) @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  appliedPromos Json       @default("[]")
  total         Decimal    @default(0) @db.Decimal(10, 2)
  status        CartStatus @default(OPEN)
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())

  @@unique([tenantId, sessionId])
  @@index([tenantId, status])
}

model Order {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  code           String       @unique
  items          Json
  subtotal       Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  // Monto del delivery sumado al total. null = no aplica (pickup,
  // dine-in, o delivery "acordado con el proveedor" desde el menú
  // público — el cliente y el negocio coordinan el monto por WhatsApp
  // sin que el panel lo cobre automáticamente).
  deliveryAmount Decimal?     @db.Decimal(10, 2)
  total          Decimal      @db.Decimal(10, 2)
  status         OrderStatus  @default(PENDING)
  channel        OrderChannel @default(WHATSAPP_LINK)
  fulfillment    Fulfillment  @default(PICKUP)
  /// Discriminador explícito del menú público desde donde se generó la orden:
  /// 'MESA' o 'DELIVERY'. Es redundante con `fulfillment`/`deliveryAddress`
  /// pero permite reportes y filtros sin inferir. Nullable para back compat
  /// con órdenes previas a la separación de menús (2026-06-06).
  mode           String?

  tableNumber     String?
  deliveryAddress Json?
  customerNote    String?
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appliedPromos   Json      @default("[]")
  whatsappLink    String?

  // Pagos online (v3)
  paymentStatus   PaymentStatus @default(NOT_REQUIRED)
  paymentMethod   PaymentMethod @default(CASH_ON_DELIVERY)
  paymentProvider String? // p.ej. "stripe", "mercado_pago", "wompi", "stub"
  paymentRef      String? // id de la transacción del gateway
  paymentUrl      String? // URL/redirect para pagar
  paidAt          DateTime?

  confirmedAt DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  // Calificación post-entrega (1-5 estrellas + comentario opcional)
  rating        Int?
  ratingComment String?
  ratedAt       DateTime?

  events           OrderEvent[]
  stamps           Stamp[]
  redemptions      PromotionRedemption[]
  // Red de Domicilios (Fase 1, 2026-06-29): seguimiento logístico 1:1 (opcional).
  delivery         Delivery?
  // Chat del domicilio (Fase 3B): hilo cliente↔negocio↔empresa.
  deliveryMessages DeliveryMessage[]

  @@index([tenantId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([tenantId, ratedAt])
}

model OrderEvent {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  metadata  Json           @default("{}")
  actorId   String?
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
}

// ============================================================
//                       PROMOTIONS (v2)
// ============================================================

model Promotion {
  id                        String        @id @default(uuid())
  tenantId                  String
  tenant                    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                      String
  description               String        @default("")
  imageUrl                  String?
  type                      PromotionType
  value                     Decimal       @db.Decimal(10, 2)
  /// Precio regular del producto antes del descuento. NULL = no se muestra
  /// como producto en oferta. Se renderiza tachado al lado del precio promo.
  originalPrice             Decimal?      @db.Decimal(10, 2)
  conditions                Json          @default("{}")
  validFrom                 DateTime?
  validUntil                DateTime?
  maxRedemptions            Int?
  maxRedemptionsPerCustomer Int?
  isActive                  Boolean       @default(true)
  createdAt                 DateTime      @default(now())

  redemptions PromotionRedemption[]

  @@index([tenantId, isActive])
}

model PromotionRedemption {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId  String
  amountSaved Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([promotionId])
}

// ============================================================
//                       AUTOMATIONS (v2)
// ============================================================

model AutomationRule {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  trigger     Json
  conditions  Json     @default("[]")
  actions     Json
  stats       Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  runs AutomationRun[]

  @@index([tenantId, isActive])
}

model AutomationRun {
  id           String              @id @default(uuid())
  ruleId       String
  rule         AutomationRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventPayload Json
  status       AutomationRunStatus
  error        String?
  executedAt   DateTime            @default(now())

  @@index([ruleId, executedAt])
}

// Fase B (PDF734): workflows multipaso por tenant. A diferencia de
// AutomationRule (1 evento → N acciones instantáneas), un workflow es una
// SECUENCIA ordenada de pasos con esperas (enviar → esperar días/horas →
// enviar …). Un disparador inscribe al cliente (AutomationEnrollment) y un cron
// avanza los pasos. `steps` = array JSON ordenado de pasos
// (SEND_SMS/SEND_WHATSAPP/SEND_PUSH/WAIT).
model AutomationWorkflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String   @default("")
  triggerType String
  triggerDays Int?
  steps       Json     @default("[]")
  isActive    Boolean  @default(false)
  stats       Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments AutomationEnrollment[]

  @@index([tenantId, isActive])
}

// Inscripción de un cliente en un workflow. `stepIndex` = próximo paso a
// ejecutar; `nextRunAt` = cuándo debe correr (los WAIT lo empujan al futuro).
// status: active | done | stopped. Unique (workflowId, customerId) = un pase por
// cliente por workflow (base; re-inscripción se hará en un incremento posterior).
model AutomationEnrollment {
  id         String             @id @default(cuid())
  workflowId String
  workflow   AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tenantId   String
  customerId String
  stepIndex  Int                @default(0)
  status     String             @default("active")
  nextRunAt  DateTime
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([workflowId, customerId])
  @@index([status, nextRunAt])
  @@index([tenantId])
}

// ── WORKFLOWS DE MARCA BLANCA (panel /admin/automatizaciones) ───────────────
// Motor durable por @Cron: un NEGOCIO (Tenant) de la marca entra al workflow y
// avanza por nodos (SMS al dueño por la subcuenta de la marca, esperas, ramas).
model BrandWorkflow {
  id           String   @id @default(uuid())
  whiteLabelId String
  name         String
  folderId     String?
  status       String   @default("draft") // draft | published
  trigger      Json     @default("{}") // { type, filters }
  rootId       String? // primer nodo
  nodes        Json     @default("{}") // { [id]: { id, type, config, next, yes, no } }
  drip         Json     @default("{}")
  sendWindow   Json     @default("{}")
  reentry      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([whiteLabelId, status])
}

model BrandWorkflowFolder {
  id           String   @id @default(uuid())
  whiteLabelId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([whiteLabelId])
}

model BrandWorkflowEnrollment {
  id            String    @id @default(uuid())
  workflowId    String
  tenantId      String // negocio inscrito
  status        String    @default("active") // active | waiting | completed | removed | error
  currentNodeId String?
  resumeAt      DateTime?
  waitKind      String?
  context       Json      @default("{}")
  enteredAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  @@index([status, resumeAt])
  @@index([workflowId, tenantId])
}

model BrandWorkflowLog {
  id           String   @id @default(uuid())
  workflowId   String
  whiteLabelId String
  tenantId     String?
  nodeId       String?
  nodeType     String
  message      String   @default("")
  status       String // sent | skipped | failed | info
  result       String?
  createdAt    DateTime @default(now())

  @@index([workflowId, createdAt])
}

// ============================================================
//                       CHANNELS (v2)
// ============================================================

model ChannelConfig {
  id        String      @id @default(uuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      ChannelType
  config    Json
  isActive  Boolean     @default(true)
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([tenantId, type])
}

model Message {
  id         String           @id @default(uuid())
  tenantId   String
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?        @relation(fields: [customerId], references: [id])
  channel    ChannelType
  direction  MessageDirection
  templateId String?
  body       String
  mediaUrl   String?
  ruleId     String?
  status     MessageStatus    @default(QUEUED)
  error      String?
  externalId String?
  metadata   Json             @default("{}")
  createdAt  DateTime         @default(now())

  @@index([tenantId, createdAt])
  @@index([customerId, createdAt])
}

model MessageTemplate {
  id             String      @id @default(uuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  channel        ChannelType
  body           String
  variables      String[]
  metaTemplateId String?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  @@index([tenantId])
}

// ============================================================
//                       STOREFRONT (v2)
// ============================================================

model Storefront {
  id                     String     @id @default(uuid())
  tenantId               String     @unique
  tenant                 Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customDomain           String?    @unique
  theme                  Json       @default("{}")
  blocks                 Json       @default("[]")
  description            String     @default("")
  heroImageUrl           String?
  menuLayout             MenuLayout @default(CLASSIC)
  // Master legacy de pedidos. Si false, ningún botón de carrito aparece
  // en el storefront público (modo informativo total). Mesa = ?mesa=N
  // SIEMPRE va informativo por diseño (el QR de mesa no debe gatillar
  // pedidos), independientemente de este flag.
  ordersEnabled          Boolean    @default(true)
  // Toggle ÚNICO de delivery (vista pública sin ?mesa). Si está ON:
  //   - habilita carrito + checkout
  //   - habilita el botón "Pedir por WhatsApp"
  //   - habilita generación de pedidos hacia el backend
  // Si está OFF: la vista delivery es solo-precios (informativa, igual
  // que la vista mesa). NO existe un toggle aparte para WhatsApp porque
  // "carrito sin canal para enviar el pedido" no es un caso real (M1.3
  // 2026-06-04). La vista MESA (?mesa=N) NUNCA muestra carrito ni botón
  // WA, sin importar este flag (regla de negocio: cliente sentado en
  // mesa el mozo le toma el pedido).
  ordersDeliveryEnabled  Boolean    @default(true)
  // Popup que aparece después de N segundos de abrir el menú público. Si
  // tiene imagen + está enabled + popupCardId, hace click en la imagen y
  // lleva al cliente a /c/{popupCardId} para inscribirse a la tarjeta.
  // popupDelaySeconds: segundos antes de mostrar el popup. Default 10s.
  popupEnabled           Boolean    @default(false)
  popupImageUrl          String?
  popupCardId            String?
  popupCard              Card?      @relation("StorefrontPopupCard", fields: [popupCardId], references: [id], onDelete: SetNull)
  popupDelaySeconds      Int        @default(10)
  // Popup global del Menú Libro (M3 2026-06-04). Aparece N segundos
  // después de que el cliente abre /book/<slug>. Independiente del popup
  // del digital menú (que es enrollment a Card). Acá la lógica es
  // promocional (título + descripción + botón).
  //
  // M9 (2026-06-06): discriminator `bookPopupType` extiende el comportamiento
  // a 3 modos mutuamente excluyentes:
  //   - EXTERNAL_LINK (default + back compat): bookPopupButtonUrl + bookPopupButtonText.
  //   - CARD: bookPopupCardId apunta a una Card del MISMO tenant. El front
  //     redirige al enroll /c/<cardId>. bookPopupCardCtaLabel customiza el CTA.
  //   - IMAGE: solo visualización (bookPopupImageUrl + bookPopupImageCaption opcional, sin CTA).
  // Si bookPopupType es NULL se interpreta como EXTERNAL_LINK (back compat
  // con popups creados antes de M9).
  bookPopupEnabled       Boolean    @default(false)
  bookPopupTitle         String?
  bookPopupDescription   String?    @db.Text
  bookPopupImageUrl      String?
  bookPopupButtonText    String?
  bookPopupButtonUrl     String?
  bookPopupButtonColor   String?
  bookPopupDelaySeconds  Int        @default(5)
  bookPopupType          String?
  bookPopupCardId        String?
  bookPopupCard          Card?      @relation("StorefrontBookPopupCard", fields: [bookPopupCardId], references: [id], onDelete: SetNull)
  bookPopupCardCtaLabel  String?
  bookPopupImageCaption  String?
  // Si false, el botón de WhatsApp NO se muestra en el menú público aunque
  // el tenant tenga whatsappPhone seteado. Permite que el dueño "apague"
  // el botón sin perder el número configurado en /app/settings.
  whatsappButtonEnabled  Boolean    @default(true)
  // Color de fondo de la página pública del menú. NULL = usar el default
  // del layout (#FAFBFC para layouts claros, #0a0a0a para CLUVI). El
  // editor lo expone principalmente para el layout SECTIONS donde el
  // dueño quiere matchear el fondo con su brand. Cualquier color CSS
  // válido (#hex, rgb(), nombre).
  pageBackgroundColor    String?
  // Tipo de fondo: 'SOLID' (usa pageBackgroundColor), 'GRADIENT' (usa
  // pageBackgroundGradient), 'IMAGE' (usa pageBackgroundImageUrl). NULL
  // = SOLID por compat con storefronts viejos.
  pageBackgroundType     String?
  // CSS gradient completo (ej: "linear-gradient(135deg, #6366F1, #EC4899)").
  // Solo se aplica si pageBackgroundType='GRADIENT'.
  pageBackgroundGradient String?
  // URL de imagen R2 para el fondo. Se renderea como background-size cover
  // + center. Solo se aplica si pageBackgroundType='IMAGE'.
  pageBackgroundImageUrl String?
  // Color de fondo del contenedor del logo en el header del storefront
  // público. NULL = blanco (default histórico). Cualquier CSS válido,
  // incluyendo "transparent" para logos con fondo propio que deben
  // verse edge-to-edge sobre la pageBackgroundColor.
  logoBgColor            String?
  // Color del título (brandName) en el header del storefront público.
  // NULL = default según layout (ink en claros, white en CLUVI). Cualquier
  // CSS válido. Útil para matchear branding sobre fondos custom.
  titleColor             String?
  // Color de la descripción (subtítulo) del header. NULL = default
  // (text-mute en claros, white/70 en CLUVI). Mismo formato que titleColor.
  descriptionColor       String?
  // Estilo del botón "Volver" que aparece sobre la portada de cada
  // sección en el layout SECTIONS. JSON con bgColor/iconColor/opacity/
  // borderColor/borderWidth/shadow/size. NULL = usar default
  // (negro semitransparente con flecha blanca). Configurable desde
  // /app/storefront cuando el contraste no funciona contra portadas
  // claras u oscuras.
  backButtonConfig       Json?
  // Cover banner para la sección virtual "Recomendados" del menú público
  // (la que junta los productos isRecommended). Hasta acá se renderizaba
  // sin banner; ahora se puede editar igual que las categorías normales.
  // null = sin banner custom (se muestra un default minimal).
  recommendedTagline     String?
  recommendedCoverConfig Json?
  // Modos de menú: digital tradicional (productos/servicios en `/m/<slug>`)
  // y libro flipbook (imágenes en `/book/<slug>`). Independientes — un
  // tenant puede tener activos los 2, uno solo, o ninguno. Reemplazan la
  // semántica vieja donde `menuLayout=FLIPBOOK` excluía al digital.
  digitalMenuEnabled     Boolean    @default(true)
  bookMenuEnabled        Boolean    @default(false)
  // #29 (2026-06-16): orientación del swipe del menú libro:
  // HORIZONTAL (izq↔der, default) o VERTICAL (arriba↕abajo).
  bookMenuDirection      String     @default("HORIZONTAL")
  isPublished            Boolean    @default(true)
  createdAt              DateTime   @default(now())
}

enum MenuLayout {
  CLASSIC // foto izq + info der + tabs sticky (Rappi/UberEats)
  GRID // 2 columnas, fotos cuadradas grandes (Instagram)
  CAROUSELS // hero + scroll horizontal por categoría (Netflix)
  CLEAN // lista limpia sin fotos, serif (boutique)
  COMPACT // lista compacta + modal sheet (DoorDash)
  CLUVI // dark bg + white cards + yellow accents + VER pill (Cluvi/Bananas)
  SECTIONS // banners grandes por sección con portada editable (premium)
  FLIPBOOK // menú visual tipo libro/catálogo con páginas-imagen y secciones
}

// ============================================================
//        FLIPBOOK MENU (menú visual tipo libro)
// ============================================================
//
// Cuando Storefront.menuLayout = FLIPBOOK, el menú público se renderiza
// como un libro digital paginado en vez de la grilla clásica de
// productos. Las secciones agrupan páginas-imagen que se pasan como
// hojas, con navegación superior por sección y popups opcionales por
// imagen (promo, ingredientes, reserva, etc).
//
// Coexiste con el menú clásico por Category/Product: el tenant elige
// qué layout usar en /app/storefront → menuLayout. Si vuelve a CLASSIC
// las secciones flipbook quedan persistidas pero no se renderizan.

model MenuBookSection {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title             String
  // Orden visual. Más bajo aparece primero en la navegación superior y
  // las páginas se concatenan en este orden.
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  // Popup que aparece al entrar a esta sección (M3 2026-06-04). Misma
  // shape que MenuBookPage.popup* para consistencia. Si popupEnabled=
  // false el resto se ignora.
  //
  // M9 (2026-06-06): popupType extiende a 3 modos (EXTERNAL_LINK / CARD /
  // IMAGE). NULL = EXTERNAL_LINK por back compat. Ver comentario en
  // Storefront.bookPopupType para detalle.
  popupEnabled      Boolean  @default(false)
  popupTitle        String?
  popupDescription  String?  @db.Text
  popupImageUrl     String?
  popupButtonText   String?
  popupButtonUrl    String?
  popupButtonColor  String?
  popupType         String?
  popupCardId       String?
  popupCard         Card?    @relation("MenuBookSectionPopupCard", fields: [popupCardId], references: [id], onDelete: SetNull)
  popupCardCtaLabel String?
  popupImageCaption String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pages MenuBookPage[]

  @@index([tenantId, sortOrder])
}

model MenuBookPage {
  id        String          @id @default(uuid())
  sectionId String
  section   MenuBookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  imageUrl  String
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Popup inline (siempre 1:1 con la página — modelo separado sería
  // overkill). Si popupEnabled=false el resto se ignora.
  //
  // M9 (2026-06-06): popupType extiende a 3 modos (EXTERNAL_LINK / CARD /
  // IMAGE). NULL = EXTERNAL_LINK por back compat.
  popupEnabled      Boolean @default(false)
  popupTitle        String?
  popupDescription  String? @db.Text
  popupImageUrl     String?
  popupButtonText   String?
  popupButtonUrl    String?
  popupButtonColor  String? // hex, default lo decide el front
  popupType         String?
  popupCardId       String?
  popupCard         Card?   @relation("MenuBookPagePopupCard", fields: [popupCardId], references: [id], onDelete: SetNull)
  popupCardCtaLabel String?
  popupImageCaption String?

  @@index([sectionId, sortOrder])
}

// ============================================================
//                 INFO LINKS (mini-páginas tipo Linktree+)
// ============================================================

model InfoLink {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug         String
  // URL "vanity" global del Infolink — si está set, accesible como
  // soyclubify.com/<rootSlug> en lugar de /i/<tenantSlug>/<linkSlug>.
  // Unique global (no por tenant) porque vive en la raíz del dominio.
  // null = sin vanity, sigue accesible solo por /i/<tenant>/<link>.
  rootSlug     String?  @unique
  title        String
  subtitle     String?
  heroImageUrl String?
  gallery      Json     @default("[]")
  sections     Json     @default("[]")
  buttons      Json     @default("[]")
  theme        Json     @default("{}")
  isActive     Boolean  @default(true)
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events InfoLinkEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model InfoLinkEvent {
  id         String   @id @default(uuid())
  infoLinkId String
  infoLink   InfoLink @relation(fields: [infoLinkId], references: [id], onDelete: Cascade)
  type       String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([infoLinkId, type, createdAt])
}

// ============================================================
//                       EVENTS (audit/analytics sink)
// ============================================================

model Event {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  customerId String?
  type       String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([tenantId, type, createdAt])
}

// ============================================================
//                       REFERRALS (v1)
// ============================================================

// Rol del titular del código (Fase 2 — sistema de campañas).
//   - INFLUENCER: 30% directo, 5% indirecto cuando lo usa un embajador suyo.
//   - AMBASSADOR: 25% directo, está dentro de una campaña de un influencer.
//   - SOCIO: 10% global de toda venta. No depende de qué código se use.
// Default INFLUENCER para compat con códigos existentes (eran "afiliados"
// individuales sin jerarquía y todos se comportaban como influencer directo).
enum ReferralRole {
  INFLUENCER
  AMBASSADOR
  SOCIO
  // VENDOR: vendedor que reporta a un EMBAJADOR. Solo se setea cuando un
  // embajador con allowVendors=true crea un vendedor desde su panel.
  // El vendedor cobra su % directo de la venta y el embajador recibe SU
  // % menos lo del vendedor (3-way split en webhook Hotmart).
  VENDOR
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

model ReferralCode {
  id                             String         @id @default(uuid())
  code                           String         @unique
  // Slug corto y human-friendly para links `/ref/<slug>`. Único, opcional.
  // Default: lowercase(code) backfill en migration. Customizable desde admin.
  slug                           String?        @unique
  ownerName                      String
  ownerEmail                     String
  ownerWhatsapp                  String
  // #37 (2026-06-16): país del afiliado (code ISO-2, p.ej. "CO"). Capturado
  // en el autoregistro público y en la creación manual. Nullable porque los
  // codes legacy no lo tienen.
  country                        String?
  ownerUserId                    String?
  ownerUser                      User?          @relation(fields: [ownerUserId], references: [id])
  // Marca blanca dueña del afiliado. Los referidos son 100% independientes
  // por marca: cada Master Admin de marca ve SOLO sus influencers/embajadores/
  // vendedores. Nullable solo durante el backfill (los existentes se asignan
  // a "Clubify"). onDelete SetNull para no perder el código si se borra la
  // marca.
  whiteLabelId                   String?
  whiteLabel                     WhiteLabel?    @relation("WhiteLabelReferralCodes", fields: [whiteLabelId], references: [id], onDelete: SetNull)
  commissionPercent              Decimal        @default(20) @db.Decimal(5, 2)
  role                           ReferralRole   @default(INFLUENCER)
  // Si role=AMBASSADOR, parentCodeId apunta al ReferralCode del influencer
  // dueño de la campaña. Cuando un cliente usa este código, además de la
  // comisión directa del embajador, generamos una comisión indirecta para
  // el influencer (5% por defecto).
  parentCodeId                   String?
  parentCode                     ReferralCode?  @relation("AmbassadorParent", fields: [parentCodeId], references: [id], onDelete: SetNull)
  ambassadors                    ReferralCode[] @relation("AmbassadorParent")
  // VENDOR sub-jerarquía: cuando role=AMBASSADOR y allowVendors=true,
  // el embajador puede crear vendedores debajo suyo. `maxCommissionPercent`
  // es el tope que puede repartir entre vendedores (default 25 enforced en
  // aplicación si null).
  allowVendors                   Boolean        @default(false)
  maxCommissionPercent           Decimal?       @db.Decimal(5, 2)
  // % por defecto que se aplica a los vendedores creados desde el
  // self-register link `/seller/register/<ambassadorCode>`. El embajador
  // lo configura desde su panel /affiliate/team. Si null, default 10%.
  // Backend valida: 0 < value <= maxCommissionPercent (??25) - usadoActivo.
  defaultVendorCommissionPercent Decimal?       @db.Decimal(5, 2)
  // Solo se setea cuando role=VENDOR. FK self-relation al embajador padre.
  // El vendedor cobra su % directo y el embajador recibe SU % menos lo
  // del vendedor en el 3-way split del webhook Hotmart.
  parentEmbajadorCodeId          String?
  parentEmbajadorCode            ReferralCode?  @relation("VendorEmbajador", fields: [parentEmbajadorCodeId], references: [id], onDelete: SetNull)
  childVendors                   ReferralCode[] @relation("VendorEmbajador")
  // Si pertenece a una campaña (los embajadores siempre, los influencers
  // pueden ser titulares de su propia campaña).
  campaignId                     String?
  campaign                       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  isActive                       Boolean        @default(true)
  // Cuándo se aprobó el embajador (cuando un INFLUENCER lo crea desde su
  // panel). Si null y la config requiere aprobación, queda invisible al
  // generar comisiones hasta que el admin apruebe. Para códigos creados
  // por el super admin se setea a createdAt automáticamente.
  approvedAt                     DateTime?
  // Etiqueta de origen del afiliado (?source=X en /refer). Solo informativa.
  source                         String?
  createdAt                      DateTime       @default(now())

  uses                   ReferralUse[]
  visits                 ReferralVisit[]
  ownerOfCampaign        Campaign?             @relation("CampaignOwner")
  /// Materiales de apoyo scope a este influencer (visibles solo a sus
  /// embajadores). Vacío para mayoría — los materiales globales no van acá.
  scopedSupportMaterials SupportMaterial[]     @relation("SupportMaterialScope")
  /// Atribuciones donde este code es el vendor (role=VENDOR). Inverso de
  /// Commission.vendorCode. Solo se usa para listings/reporting.
  vendorCommissions      Commission[]          @relation("CommissionVendor")
  /// Commissions cuya persona destinataria es este code (3-way split).
  /// Inverso de Commission.recipientCode. Permite query directo "todas
  /// las commissions del influencer X" sin walkear el referralUse.
  receivedCommissions    Commission[]          @relation("CommissionRecipient")
  /// Grupos empresariales donde este code es el recipiente de comisión (Punto 2).
  recipientGroups        BusinessGroup[]       @relation("BusinessGroupRecipient")
  /// Item 6 sprint: excepciones de comisión cuya recipientCodeId apunta
  /// a este code (= aplican al % que ESTE code cobraría normalmente).
  commissionExceptions   CommissionException[]

  @@index([parentCodeId])
  @@index([parentEmbajadorCodeId])
  @@index([campaignId])
}

// Visita registrada al link corto `/ref/<slug>`. Sirve para medir
// rendimiento por afiliado/embajador antes de la conversión a signup
// (CTR del link → tasa de conversión). Atribuida a ReferralCode si el
// slug matchea uno existente.
model ReferralVisit {
  id             String        @id @default(uuid())
  slug           String
  referralCodeId String?
  referralCode   ReferralCode? @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  ip             String?
  userAgent      String?       @db.Text
  country        String?
  referer        String?       @db.Text
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  createdAt      DateTime      @default(now())

  @@index([slug])
  @@index([referralCodeId, createdAt])
}

// Campaña — agrupa un influencer principal y sus embajadores.
// El influencer se modela como un ReferralCode con role=INFLUENCER y
// el campo `ownerCodeId` apunta a él. La relación inversa se usa para
// listar las campañas de un influencer.
model Campaign {
  id          String         @id @default(uuid())
  name        String
  ownerCodeId String         @unique
  ownerCode   ReferralCode   @relation("CampaignOwner", fields: [ownerCodeId], references: [id], onDelete: Cascade)
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())

  codes ReferralCode[]
}

model ReferralUse {
  id             String         @id @default(uuid())
  referralCodeId String
  referralCode   ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id])
  status         ReferralStatus @default(SIGNED_UP)
  // Atribución: si el cliente llegó vía `/ref/<slug>` guardamos el slug y
  // los UTM parameters que capturamos para análisis de fuente.
  viaSlug        String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  referer        String?        @db.Text
  createdAt      DateTime       @default(now())
  convertedAt    DateTime?

  commissions Commission[]

  @@index([referralCodeId, status])
}

model Commission {
  id                   String                      @id @default(uuid())
  // Nullable (Punto 2, 2026-07-01): las comisiones a nivel GRUPO EMPRESARIAL no
  // cuelgan de un tenant/referralUse; usan businessGroupId. Para comisiones
  // normales (por tenant) SIEMPRE va seteado.
  referralUseId        String?
  referralUse          ReferralUse?                @relation(fields: [referralUseId], references: [id], onDelete: Cascade)
  // Grupo Empresarial dueño de la comisión (1 comisión por el bruto del grupo).
  // Mutuamente excluyente con referralUseId. Null = comisión normal por tenant.
  businessGroupId      String?
  businessGroup        BusinessGroup?              @relation(fields: [businessGroupId], references: [id], onDelete: SetNull)
  amount               Decimal                     @db.Decimal(10, 2)
  currency             String                      @default("USD")
  status               CommissionStatus            @default(PENDING)
  paidAt               DateTime?
  // Momento en que la comisión se DESBLOQUEA (PENDING → APPROVED): 15 días
  // DESPUÉS del pago real en Hotmart (Tenant.lastChargeAt / la fecha del cobro
  // del grupo), NO desde createdAt de la comisión ni la creación de la cuenta.
  // Null en comisiones legacy → fallback a createdAt + 15 días. (P3 2026-07-02)
  availableAt          DateTime?
  // Nota interna del super admin (ej: "Pagado vía Wise", "Cliente
  // contactado el 2026-05-12, prometió pagar"). Visible solo en panel.
  notes                String?                     @db.Text
  // Marca de contacto al cliente cuando hubo pago fallido — se setea
  // desde la tab "Pendientes por pagar" para llevar registro.
  clientContactedAt    DateTime?
  // Dedup key: transactionId externo (Hotmart `transaction` / `subscriber_code`,
  // manual=null). Si llega un webhook con el mismo externalTxId que ya
  // existe en Commission, skip (evita doble-pay con convertToPaying
  // manual + webhook Hotmart posterior del mismo ciclo).
  externalTxId         String?
  // Hotmart transaction ID — alias semántico de externalTxId específico
  // para el 3-way split. Si llega 2 veces el mismo transactionId con el
  // mismo referralCodeId del use, dedup silencioso.
  hotmartTransactionId String?
  // Atribución del vendedor en la sale (solo se setea cuando la chain
  // de atribución incluye un VENDOR). Null cuando no había vendedor.
  // En el 3-way split el vendor también tiene SU propia Commission row.
  vendorCodeId         String?
  vendorCode           ReferralCode?               @relation("CommissionVendor", fields: [vendorCodeId], references: [id], onDelete: SetNull)
  // Tracking granular de pago: PENDING (nada pagado), PARTIAL (pagado
  // parcial), PAID (pagado >= amount). Independiente de `status` que
  // refleja el flow de aprobación.
  paymentStatus        CommissionPaymentStatus     @default(PENDING)
  // Monto efectivamente pagado al afiliado, para tracking de pagos
  // parciales. Sirve para reconciliación contable. Default 0.
  amountPaid           Decimal                     @default(0) @db.Decimal(10, 2)
  // SNAPSHOT contable (Fase 4): se congelan al generar la comisión y NO se
  // recalculan. Permiten auditar exactamente con qué se calculó. Nullable =
  // comisiones legacy generadas antes del overhaul.
  distributionMode     CommissionDistributionMode?
  baseAmountUsd        Decimal?                    @db.Decimal(10, 2)
  appliedPercent       Decimal?                    @db.Decimal(5, 2)
  // Recipient del 3-way split: el ReferralCode QUE RECIBE esta commission.
  // En un sale con vendedor, se generan 3 Commission rows pointing al
  // mismo referralUseId pero distinto recipientCodeId (uno por persona:
  // influencer, embajador, vendedor). Permite filtrar "todas las
  // commissions de X persona" sin tener que walking la chain del use.
  // Backwards-compat null: rows viejas (pre-3-way) lo tienen null y se
  // resuelven derivándolo del use.code.
  recipientCodeId      String?
  recipientCode        ReferralCode?               @relation("CommissionRecipient", fields: [recipientCodeId], references: [id], onDelete: SetNull)
  // Fase D 2026-06-07: link al batch de pago que liquidó esta commission.
  // SetNull: si se borra el payout, la commission vuelve a estar
  // "pendiente de pago" sin perder historial.
  payoutItem           CommissionPayoutItem?
  // 2026-06-12: período de devengamiento (YYYY-MM). Sirve como dedup
  // key estructural junto a (referralUseId, recipientCodeId) para que
  // la DB rechace duplicados con UNIQUE constraint, no solo el código.
  // Nullable por backwards-compat con filas pre-migration que tienen
  // recipientCodeId también null. Los inserts nuevos siempre lo setean.
  periodKey            String?
  createdAt            DateTime                    @default(now())

  // 2026-06-12: previene duplicados a nivel DB. PostgreSQL trata NULLs
  // como distintos, así que filas legacy con recipientCodeId/periodKey
  // null no chocan. Para filas nuevas (ambos NOT NULL) garantiza
  // unicidad y race-safety atómica vs el código de aplicación.
  @@unique([referralUseId, recipientCodeId, periodKey])
  @@index([status])
  @@index([externalTxId])
  @@index([vendorCodeId])
  @@index([recipientCodeId])
  @@index([businessGroupId])
  @@index([hotmartTransactionId])
  // HOTFIX 2026-06-05 (bug #19): indexes para filtros del panel
  // /admin/commissions y /admin/commissions/payments.
  @@index([paymentStatus])
  @@index([paymentStatus, createdAt])
}

// ============================================================
//                    AI SUPPORT KNOWLEDGE
// ============================================================
//
// Entradas de conocimiento que entrenan al asistente IA del widget de
// soporte. El super admin las crea/edita desde /admin/ai-knowledge y se
// inyectan en el system prompt cuando un tenant abre el chat.
//
// Cada entrada tiene una audience (TENANT, AFFILIATE, BOTH) que filtra
// qué knowledge se inyecta según quién pregunta — el panel tenant ve
// info de producto, el panel afiliado ve info de ventas, BOTH se ve
// en ambos.
//
// Si la entrada viene de un documento (KnowledgeDocument), documentId
// apunta a él y chunkIndex indica su posición (0-based). El embedding
// (vector de floats serializado como JSON) se genera con Voyage AI al
// procesar el documento — usado para retrieval semántico top-K en vez
// de inyectar TODAS las entries en el prompt.
model KnowledgeEntry {
  id             String             @id @default(uuid())
  title          String
  content        String             @db.Text
  category       String             @default("General")
  audience       KnowledgeAudience  @default(BOTH)
  isActive       Boolean            @default(true)
  documentId     String?
  document       KnowledgeDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex     Int?
  embedding      Json?
  embeddingModel String?
  tokenCount     Int?
  // Marca blanca dueña de esta entrada de knowledge. null = COMPARTIDA (sirve
  // de fallback a todas las marcas). El asistente filtra por [marca, null] para
  // que cada marca responda con SUS datos sin mezclar con otras.
  whiteLabelId   String?
  whiteLabel     WhiteLabel?        @relation("WhiteLabelKnowledge", fields: [whiteLabelId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([isActive, audience])
  @@index([whiteLabelId, isActive, audience])
  @@index([documentId])
}

enum KnowledgeAudience {
  TENANT
  AFFILIATE
  BOTH
}

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

// Documento original subido por el admin (PDF/DOCX/TXT/MD). Se parsea,
// se chunkea y cada chunk se guarda como KnowledgeEntry asociado. Si el
// documento se elimina, sus chunks caen en cascada.
model KnowledgeDocument {
  id           String                  @id @default(uuid())
  title        String
  fileUrl      String? // URL pública R2 del archivo original
  fileType     String // pdf, docx, txt, md
  fileSize     Int? // bytes
  audience     KnowledgeAudience       @default(BOTH)
  category     String                  @default("General")
  status       KnowledgeDocumentStatus @default(UPLOADED)
  totalChars   Int                     @default(0)
  chunkCount   Int                     @default(0)
  errorMessage String?                 @db.Text
  isActive     Boolean                 @default(true)
  uploadedAt   DateTime                @default(now())
  processedAt  DateTime?

  entries KnowledgeEntry[]

  @@index([status])
  @@index([audience])
}

// ============================================================
//             SUPPORT MATERIAL (sales enablement)
// ============================================================
// Biblioteca de recursos curada por el super admin para que los
// afiliados (influencer / embajador) los descarguen / consulten desde
// su panel /affiliate. Distinto de KnowledgeDocument:
// - SupportMaterial NO se procesa para RAG ni se embebe; es directo
//   para descarga / link / view (PDF, video link, script copyable, etc.)
// - Soporta scope por audiencia + opcional por influencer específico
//   (ej: "solo embajadores de Maria López").
// - Categorías libres (texto) — el admin organiza como quiera.

enum SupportMaterialType {
  PDF
  IMAGE
  VIDEO
  AUDIO
  LINK
  SCRIPT
  PRESENTATION
  TEMPLATE
  OTHER
}

enum SupportMaterialAudience {
  INFLUENCER
  AMBASSADOR
  BOTH
  // 2026-06-12 (F): VENDOR ve materiales scoped a vendors O heredados
  // del embajador padre. ALL = visible para INFLUENCER/AMBASSADOR/VENDOR.
  VENDOR
  ALL
}

model SupportMaterial {
  id                String                  @id @default(uuid())
  title             String
  description       String?                 @db.Text
  type              SupportMaterialType
  /// URL pública R2 cuando hay un archivo subido (PDF/IMAGE/AUDIO/etc.).
  /// Para type=LINK/VIDEO suele ser null y se usa externalUrl.
  fileUrl           String?
  /// URL externa (YouTube, Drive, Loom, etc.). Para type=VIDEO/LINK.
  externalUrl       String?
  /// Thumbnail opcional — preview en grilla. Si null, el frontend usa
  /// un ícono por type.
  thumbnailUrl      String?
  /// Para SCRIPT: texto plano para copiar. Hasta ~10k chars.
  scriptBody        String?                 @db.Text
  /// Categoría libre: "Primeros pasos", "Scripts WA", etc. El admin
  /// la escribe — autocomplete con valores existentes en el front.
  category          String                  @default("General")
  audience          SupportMaterialAudience @default(BOTH)
  /// Si está seteado, solo embajadores cuyo parentCode pertenezca a
  /// este influencer ven el material. Útil para "material exclusivo del
  /// equipo de X". Si null, todos los que matcheen audience lo ven.
  scopeInfluencerId String?
  scopeInfluencer   ReferralCode?           @relation("SupportMaterialScope", fields: [scopeInfluencerId], references: [id], onDelete: SetNull)
  order             Int                     @default(0)
  isActive          Boolean                 @default(true)
  createdById       String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([audience, isActive])
  @@index([category])
  @@index([scopeInfluencerId])
}

// ============================================================
//                    GOOGLE REVIEW FILTER
// ============================================================
// Cuando un cliente escanea el QR de "déjame una reseña" en /r/{slug},
// elige rating 1-5. Si es 4-5 → lo redirigimos a Google Reviews (URL
// configurada por el tenant). Si es 1-3 → lo capturamos acá privado
// con un comentario opcional, evitando que la mala review llegue a
// Google. Inspirado en patrón de NudoCowork / similar a Wisely.
model ReviewFeedback {
  id                 String          @id @default(uuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rating             Int // 1-5
  comment            String?         @db.Text
  customerName       String?
  customerPhone      String?
  // true = el cliente pulsó "ir a Google" (era ≥threshold★, lo redirigimos)
  // false (default) = lo capturamos acá privado por <threshold★
  redirectedToGoogle Boolean         @default(false)
  // Permite al dueño marcar como leída en el panel
  isRead             Boolean         @default(false)
  // M7.3: target del QR de reseñas multi-sede que originó este feedback.
  // null = vino del link genérico del tenant (sin segmentar por sede).
  reviewTargetId     String?
  reviewTarget       ReviewQrTarget? @relation(fields: [reviewTargetId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, rating])
  @@index([reviewTargetId])
}

// M7.3 (2026-06-04): cada sede del negocio puede tener su propio QR de
// reseñas con su propia URL de Google + threshold + métricas. El QR
// público apunta a /r/<slug>?target=<id>; sin ?target= cae al link
// genérico Tenant.googleReviewUrl.
model ReviewQrTarget {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Sede asociada (opcional). Si null, el target es libre — útil para
  /// campañas no atadas a una sede física.
  locationId      String?
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  name            String
  /// Dirección legible mostrada en el selector de sede del /r/<slug>
  /// cuando el negocio tiene 2+ sedes (multi-sede 2026-06-06).
  address         String?
  /// URL completa de Google Reviews para esta sede.
  googleReviewUrl String
  /// Rating mínimo inclusive para redirigir a Google (1-5). Default 4.
  threshold       Int              @default(4)
  isActive        Boolean          @default(true)
  /// Orden de display en el selector multi-sede y admin (drag-and-drop).
  position        Int              @default(0)
  feedbacks       ReviewFeedback[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([locationId])
  @@index([tenantId, isActive, position])
}

// ============================================================
//                    INDUSTRIES (sales decks)
// ============================================================
// Industria = vertical de negocio (cafeterías, barberías, restaurantes,
// etc.). Wrap nivel-1 del módulo de pitch decks: cada Industry contiene
// múltiples Presentations, y cada Presentation contiene múltiples Slides.
// El SUPER_ADMIN cura el catálogo desde /admin/industries; la vista
// pública (/industrias, /industria/{slug}) es para mostrar a prospects
// el deck adecuado a su vertical.
//
// F1 sólo agrega el modelo Industry. Presentations y Slides llegan en F2.
model Industry {
  id          String             @id @default(uuid())
  /// Nombre humano que se muestra en la card. Único — sin duplicados.
  name        String             @unique
  /// Slug URL-safe — usado en /industria/{slug}. Único.
  slug        String             @unique
  /// Subtítulo / descripción corta que aparece debajo del nombre.
  description String?            @db.Text
  /// Emoji decorativo de la card (👩, ☕, 💈, etc.). Opcional si hay iconUrl.
  emoji       String?
  /// URL absoluta de ícono SVG/PNG en R2. Opcional — si null se usa el emoji.
  iconUrl     String?
  /// URL de la imagen de portada en R2 — banner detrás del nombre. Opcional.
  coverImage  String?
  /// Estilo visual del banner de portada. 5 variantes para que el admin
  /// elija desde el picker. Si null se usa DARK_OVERLAY.
  coverStyle  IndustryCoverStyle @default(DARK_OVERLAY)
  /// Color principal del tema para la card (hex, ej "#22C55E"). Opcional.
  themeColor  String?
  /// Soft-disable. Si false, no se muestra en la vista pública pero queda
  /// en /admin/industries para reactivar.
  isActive    Boolean            @default(true)
  /// Orden manual en la grilla pública (asc). Se reordena con drag&drop
  /// desde /admin/industries vía endpoint /reorder.
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  presentations Presentation[]

  @@index([isActive, sortOrder])
}

/// Estilo visual del banner de portada de una industria. Cada uno
/// renderiza distinto el mismo coverImage:
///  - DARK_OVERLAY: imagen + overlay oscuro + texto blanco abajo (Netflix).
///  - GRADIENT_BRAND: imagen + gradient bottom-up del themeColor.
///  - BLUR_GLASS: imagen blureada + glass card centrada (premium).
///  - MINIMAL: imagen clean + texto compacto abajo izquierda, sin overlay.
///  - MODERN_SPLIT: split 50/50 — imagen derecha, bloque sólido themeColor izquierda.
enum IndustryCoverStyle {
  DARK_OVERLAY
  GRADIENT_BRAND
  BLUR_GLASS
  MINIMAL
  MODERN_SPLIT
}

/// Layout pre-armado para cada slide. El front renderea distinto según
/// este enum (ej COVER usa imagen full-bleed + título centrado;
/// IMAGE_LEFT pone imagen a la izq + texto a la der; etc).
enum SlideLayout {
  COVER
  IMAGE_LEFT
  IMAGE_RIGHT
  FULL_IMAGE
  TEXT_ONLY
  QUOTE
  CTA
  STATS
  COMPARISON
  VIDEO
}

/// Animación de entrada del slide. Sirve para hint visual al pasar.
/// NONE = sin animación.
enum SlideAnimation {
  NONE
  FADE
  SLIDE_RIGHT
  SLIDE_UP
  ZOOM
}

// ============================================================
//                  PRESENTATIONS + SLIDES (F2)
// ============================================================
// Pitch deck dentro de una industria. Cada Presentation pertenece a
// exactamente una Industry; el slug es único POR industria (no global)
// para que dos industrias distintas puedan tener "menu-digital" sin
// conflicto. F4 va a agregar el editor visual; F5 la vista pública en
// /presentacion/{slug}.
model Presentation {
  id          String   @id @default(uuid())
  industryId  String
  industry    Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  /// Título del deck (ej "Fidelización para cafeterías").
  title       String
  /// Slug URL-safe — usado en /presentacion/{slug}. Único POR industria.
  slug        String
  /// Descripción corta del deck — aparece en la lista de presentations
  /// dentro de la industria y en el meta de la vista pública.
  description String?  @db.Text
  /// Imagen de portada — primer frame al abrir el deck. Opcional.
  coverImage  String?
  /// Color del tema del deck (hex). Hereda del Industry si null.
  themeColor  String?
  /// Soft-disable. Si false, no se lista en la vista pública pero queda
  /// en admin para reactivar.
  isActive    Boolean  @default(true)
  /// Orden dentro de la lista de presentations de la industria.
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slides Slide[]

  @@unique([industryId, slug])
  @@index([industryId, isActive, sortOrder])
}

/// Slide individual dentro de una Presentation. El layout define la
/// estructura visual (ver enum SlideLayout); content guarda overrides
/// JSON específicos del layout (ej STATS array, COMPARISON pros/cons).
model Slide {
  id             String         @id @default(uuid())
  presentationId String
  presentation   Presentation   @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  /// Posición en el deck (asc). Drag&drop en F4 vía endpoint /reorder.
  sortOrder      Int            @default(0)
  layout         SlideLayout    @default(COVER)
  /// Título principal del slide. Opcional según layout.
  title          String?
  /// Subtítulo / línea secundaria.
  subtitle       String?
  /// Cuerpo de texto largo. Soporta markdown básico (renderizado en F5).
  body           String?        @db.Text
  /// Imagen del slide (R2 URL). Opcional.
  imageUrl       String?
  /// Video opcional para layout=VIDEO (URL R2 o YouTube embed).
  videoUrl       String?
  /// Texto del CTA (botón) — null = sin CTA.
  ctaText        String?
  /// URL del CTA. Si externa, se abre en _blank; si interna, push router.
  ctaUrl         String?
  /// Color de fondo (hex). Si null, hereda del Presentation.themeColor.
  bgColor        String?
  /// Color del texto. Si null, contrast-detect en runtime.
  textColor      String?
  /// Animación de entrada al navegar a este slide.
  animation      SlideAnimation @default(NONE)
  /// Bag JSON para layouts complejos (STATS, COMPARISON, etc) sin
  /// inflar el schema. El editor visual de F4 define la forma exacta
  /// según layout.
  content        Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([presentationId, sortOrder])
}

// ============================================================
//                    QR POSTERS / MARKETING
// ============================================================
// Carteles QR personalizables (sección "Marketing" del panel). Cada
// tenant tiene como máximo 1 poster activo por tipo. El campo `config`
// guarda el JSON serializado del editor visual (Konva): background,
// posición/estilo del QR, textos (título, subtítulo, CTA), tipografías,
// tamaño de lienzo, etc. La URL destino se calcula en render time según
// el `type` (MENU → /m/{slug}, COUNTER → /c/{cardId}, REVIEWS → /r/{slug},
// DISCOUNT → /m/{slug}?promo={code}). Así el QR sigue siendo dinámico aún
// si el negocio cambia el menú/wallet/promociones.
enum QrPosterType {
  MENU
  COUNTER
  DISCOUNT
  REVIEWS
  INFOLINK // mini-page tipo Linktree (apunta a /i/<slug>)
}

model QrPoster {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          QrPosterType
  name          String           @default("")
  // JSON del editor (capas, posiciones, colores, fuentes, etc).
  config        Json             @default("{}")
  // Último export subido a R2 (PNG/PDF). Se llena en H3 cuando se
  // implementa el export profesional para imprenta.
  lastExportUrl String?
  // Si false, el QR sigue siendo editable en el panel pero el endpoint
  // público `/q/<id>` devuelve 404 (cartel "pausado"). Útil para campañas
  // estacionales sin tener que borrar el diseño.
  isActive      Boolean          @default(true)
  // URL override por-poster. Si está seteado, el redirect dinámico
  // (/q/<id>) usa este target en vez del default del tipo. Permite que
  // un mismo tenant tenga varios QR del mismo tipo apuntando a campañas
  // distintas (ej: 1 QR Descuento → /signup?promo=A, otro → /signup?promo=B).
  // Si es null, /q/<id> resuelve al default que corresponda al `type`
  // (ej: MENU → /m/<slug>, INFOLINK → /i/<slug>).
  targetUrl     String?
  visits        QrPosterVisit[]
  exports       QrPosterExport[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Antes era @@unique([tenantId, type]) — limitaba a 1 cartel por tipo
  // por tenant. Ahora se permite N variantes (cada tenant puede tener
  // varios MENU/COUNTER/DISCOUNT/REVIEWS/INFOLINK con diseños distintos).
  @@index([tenantId, type])
}

// Tracking de scans (cuando alguien escanea un QR y dispara /q/<id>).
// El redirect dinámico crea un row acá y reenvía al targetUrl resuelto.
// Permite que cada poster tenga estadísticas individuales sin tocar el
// resto del schema. IP/UA/country se limitan en length para no explotar.
model QrPosterVisit {
  id        String   @id @default(uuid())
  posterId  String
  poster    QrPoster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  country   String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([posterId, createdAt])
}

// Tracking de descargas/exports del cartel. Cuando el dueño descarga el
// PNG/PDF se crea un row acá. Permite reportar "descargado N veces" en
// el card del poster.
model QrPosterExport {
  id        String   @id @default(uuid())
  posterId  String
  poster    QrPoster @relation(fields: [posterId], references: [id], onDelete: Cascade)
  format    String // 'PNG' | 'PDF' | 'SVG'
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([posterId, createdAt])
}

// ============================================================
//                    ADMINISTRATIVO
// ============================================================
// Recordatorios recurrentes que el dueño le manda a sus empleados por
// SMS/WhatsApp (vía Grow Business). Cron diario a las 3am scanea los
// activos y dispara los que aplican según recurrencia + hora local.
enum ReminderRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}

model Reminder {
  id            String             @id @default(uuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Empleado destinatario. Si el User se elimina, el recordatorio queda
  // huérfano (employeeId = null) — se ignora en el cron y aparece como
  // "Empleado eliminado" en la UI para que el dueño lo borre/reasigne.
  employeeId    String?
  employee      User?              @relation("ReminderEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  // Snapshot del nombre+phone al crear, por si el User cambia/se elimina
  employeeName  String
  employeePhone String
  recurrence    ReminderRecurrence
  // Para WEEKLY: 0=Domingo … 6=Sábado. Para MONTHLY: 1-28.
  // Para DAILY: ignorado.
  dayOfWeek     Int?
  dayOfMonth    Int?
  // Hora local (timezone del tenant) en formato "HH:MM" 24h.
  timeOfDay     String             @default("09:00")
  message       String             @db.Text
  isActive      Boolean            @default(true)
  lastSentAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tenantId, isActive])
}

// Proveedor para el módulo de Pedidos. El dueño los gestiona desde
// /app/admin/orders/suppliers. Phone es obligatorio (necesario para WA).
model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  notes     String?  @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  frequentProducts FrequentProduct[]

  @@index([tenantId, isActive])
}

// "Productos frecuentes" — catálogo del dueño para armar pedidos
// rápido sin re-tipear cantidad/proveedor cada vez. NO confundir con
// Product (catálogo del MENÚ público); estos son insumos internos.
model FrequentProduct {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  defaultQty  Decimal   @default(1) @db.Decimal(10, 2)
  defaultUnit String    @default("kg")
  // Lunes-Domingo del despacho recurrente. Si null, se elige al armar pedido.
  dispatchDay String?
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, supplierId])
}

// Snapshot de cada "Generar pedido" que el dueño dispara. Lo guardamos
// para historial + métricas (top proveedores por gasto). Los precios
// no se manejan acá — solo cantidades; gasto se traerá del módulo
// Compras cuando exista (por ahora KPI = count).
model PurchaseOrder {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Quién lo generó
  createdById String?
  createdAt   DateTime @default(now())

  items PurchaseOrderItem[]

  @@index([tenantId, createdAt])
}

model PurchaseOrderItem {
  id            String        @id @default(uuid())
  orderId       String
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName   String
  qty           Decimal       @db.Decimal(10, 2)
  unit          String
  supplierId    String?
  supplierName  String? // snapshot si el Supplier se borra
  supplierPhone String?
  dispatchDay   String?
  notes         String?       @db.Text

  @@index([orderId])
  @@index([supplierId])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  tenantId  String?
  action    String
  resource  String
  metadata  Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ============================================================
//                       GAMIFICATION
// ============================================================

// Insignia/badge configurable por el dueño del negocio.
// criteria.type:
//   - SCANS_TOTAL: cuando customer.scansTotal >= threshold
//   - CARDS_COMPLETED: cuando completa N cartones
//   - STREAK_DAYS: cuando alcanza N días consecutivos
//   - CASHBACK_EARNED: cuando recibe ≥ N en cashback (un solo card o todos)
//   - FIRST_VISIT: al recibir el primer sello/visita en cualquier card
//   - BIRTHDAY: el día de su cumpleaños (manual trigger via cron)
//   - CUSTOM: solo otorgable manualmente desde el panel
model Badge {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  // Emoji o glyph corto que aparece como icono
  icon        String   @default("🏅")
  color       String   @default("#F59E0B")
  // Criterios de desbloqueo automático. Si type=CUSTOM no auto-otorga.
  criteria    Json     @default("{}")
  // XP que regala al cliente al desbloquearlo (suma a customer.xpPoints).
  xpReward    Int      @default(50)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  earned CustomerBadge[]

  @@index([tenantId])
}

// Badge ganado por un customer. unique para no otorgar el mismo dos veces.
model CustomerBadge {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt   DateTime @default(now())

  @@unique([customerId, badgeId])
  @@index([customerId])
}

// ============================================================
//                       COTIZACIONES (SuperAdmin)
// ============================================================
// Propuesta comercial generada por un asesor (SUPER_ADMIN) para un
// prospect. NO está vinculada a Tenant — la cotización se hace ANTES
// de que el cliente se convierta en tenant. Los precios se congelan
// en priceSnapshot/currencySnapshot al momento de crear, así futuros
// cambios en Settings (pricing.*) no rompen PDFs generados en el pasado.
enum QuotePlan {
  ELITE
}

model Quote {
  id                  String    @id @default(uuid())
  // Token público para compartir vista de cliente — soyclubify.com/q/<token>.
  // Distinto del id para que el id interno no quede expuesto en links que
  // se mandan por WA/email. UUID es suficientemente opaco e impredecible.
  publicToken         String    @unique @default(uuid())
  customerName        String
  businessName        String
  phone               String?
  email               String?
  plan                QuotePlan
  // slug de plantilla aplicada (restaurant, coffee_shop, cowork, gym,
  // barber_shop, other). Opcional para permitir cotización "neutra".
  templateSlug        String?
  // Asesor (SUPER_ADMIN) que generó la cotización. Si el usuario se
  // elimina, mantenemos el snapshot del nombre y el FK queda en NULL
  // — la cotización sigue siendo válida y los PDFs viejos no se rompen.
  advisorId           String?
  advisor             User?     @relation("QuoteAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  advisorName         String
  // Snapshot del precio del plan cotizado en la moneda elegida.
  priceSnapshot       Decimal   @db.Decimal(10, 2)
  currencySnapshot    String    @default("USD")
  // Contador de veces que el PDF fue descargado desde el panel o desde la
  // vista pública /q/<token>. Útil para saber qué cotizaciones el cliente
  // realmente abrió/guardó (proxy de "interés"). Se incrementa via
  // POST /admin/quotes/:id/pdf-downloaded (super admin) o
  // POST /api/public/quote/:token/pdf-downloaded (cliente).
  pdfDownloadCount    Int       @default(0)
  lastPdfDownloadAt   DateTime?
  // Engagement de la vista pública /q/<token>. Se incrementa cada vez que
  // el cliente abre el link. firstViewedAt queda fijo (señal de "ya lo
  // abrió al menos una vez"); lastViewedAt es proxy de re-engagement.
  // Útil para que el asesor sepa cuándo hacer follow-up — si la cotización
  // fue vista 5 veces en 3 días, el cliente está caliente.
  viewCount           Int       @default(0)
  firstViewedAt       DateTime?
  lastViewedAt        DateTime?
  // CTA clicks — el cliente apretó "Aceptar plan X" y aterrizó en /signup
  // con qt=<token>. Bumpeado desde el useEffect del signup (no en el
  // onClick del CTA, así medimos clicks que efectivamente llegaron al
  // form en vez de abandonos en la transición). Es el tercer nivel del
  // funnel: vista → click → conversion.
  ctaClickCount       Int       @default(0)
  firstCtaClickedAt   DateTime?
  lastCtaClickedAt    DateTime?
  // Conversion tracking. Cuando el cliente click "Aceptar plan X" en
  // /q/<token>, lo mandamos a /signup?plan=X&qt=<publicToken>. El signup
  // detecta qt, busca esta cotización por publicToken y setea convertedAt
  // + convertedToTenantId con el tenant recién creado. Closed-loop entre
  // cotización emitida y customer convertido — alimenta el conversion rate
  // por asesor en el dashboard.
  convertedAt         DateTime?
  convertedToTenantId String?
  convertedToTenant   Tenant?   @relation("QuoteConvertedToTenant", fields: [convertedToTenantId], references: [id], onDelete: SetNull)
  // Archive manual del asesor — saca la cotización del listing principal
  // sin borrarla. Útil para cotizaciones viejas/perdidas/duplicadas que
  // contaminan la vista pero queremos preservar para auditoría/stats.
  // El listing filtra archivedAt: null por defecto; ?archived=1 incluye.
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([advisorId])
  @@index([plan])
  @@index([templateSlug])
  @@index([createdAt])
  @@index([archivedAt])
}

/// Subcuenta global de Grow Business gestionada por el super admin.
/// Permite que múltiples tenants compartan el mismo subaccount para
/// enviar SMS, sin que cada negocio tenga que pegar sus credenciales.
/// `name` es lo único visible al admin ("Subcuenta principal", "Backup",
/// etc). `locationId` + `apiKey` se guardan en plano (la app necesita
/// usarlas en cada request HTTP; encriptar aquí no añade seguridad real
/// frente al runtime). `isDefault` marca cuál se sugiere por default
/// cuando un tenant nuevo se vincula. `deletedAt` soft delete para no
/// romper FKs en `Tenant.reviewAlertsAccountId` (SetNull al borrar).
model GrowBusinessAccount {
  id           String    @id @default(uuid())
  name         String
  locationId   String
  apiKey       String
  /// Switch number opcional, prepone "#Switch{N}\n\n" al body si está.
  switchNumber Int?
  /// Propósito de la subcuenta para que el super admin agrupe en UI y
  /// para sugerir defaults al asignar a un tenant. Valores libres:
  /// "BILLING" (recordatorios de pago / cobros), "OPERATIONAL" (reseñas,
  /// pedidos delivery, alertas operativas), "GENERAL" (cualquier uso).
  /// Default "GENERAL" para no romper subcuentas previas.
  purpose      String    @default("GENERAL")
  isDefault    Boolean   @default(false)
  lastTestAt   DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  reviewTenants   Tenant[] @relation("ReviewAlertsAccount")
  billingTenants  Tenant[] @relation("BillingAlertsAccount")
  deliveryTenants Tenant[] @relation("DeliveryAlertsAccount")
}

// ============================================================
//                       CRM (Bloque C)
// ============================================================

// Tipo semántico de un Stage en el kanban del CRM. Las 5 primeras son
// las stages default que se auto-crean al inicializar el pipeline. CUSTOM
// es para stages creadas por el user manualmente (cambio de orden, color,
// nombre OK; pero no usamos kind=CUSTOM para automatizaciones porque no
// tiene semántica fija).
enum StageKind {
  CONTACTS
  INTERESTED
  FOLLOWUP
  CLIENT
  NOT_INTERESTED
  CUSTOM
}

// Pipeline de CRM. Cada afiliado (AFFILIATE_INFLUENCER, AFFILIATE_AMBASSADOR,
// AFFILIATE_SOCIO) tiene SU pipeline propio. 1:1 con el User en C1 — en C4
// agregaremos pipelines de equipo via SalesTeam.
model Pipeline {
  id          String   @id @default(uuid())
  ownerUserId String   @unique
  ownerUser   User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String   @default("Mi pipeline")
  createdAt   DateTime @default(now())

  stages Stage[]
}

// Columna del kanban — "Contactos", "Interesados", etc. Cada Stage
// pertenece a UN pipeline. El order es int para drag&drop visual.
model Stage {
  id         String    @id @default(uuid())
  pipelineId String
  pipeline   Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  color      String    @default("#94A3B8")
  order      Int
  kind       StageKind @default(CUSTOM)
  createdAt  DateTime  @default(now())

  contacts                    CrmContact[]
  // Botones que mueven contactos hacia este stage (C5). onDelete
  // SetNull → si la stage se borra, los botones quedan sin destino
  // (el frontend lo muestra como "Sin movimiento de stage").
  buttonsThatMoveToThis       CrmButton[]    @relation("CrmButtonMoveStage")
  // F2: steps de secuencias que mueven a este stage.
  sequenceStepsThatMoveToThis SequenceStep[] @relation("SequenceStepMoveStage")

  @@index([pipelineId, order])
}

// Contacto/prospecto del CRM. Pertenece a UN afiliado (ownerUserId).
// Vive en UNA stage del kanban (stageId). Todos los campos opcionales
// para no generar fricción al registrar — el user puede crear contactos
// con solo un nombre y completar después.
//
// Eliminar el Stage NO borra los contactos (onDelete Restrict): el
// service.deleteStage los mueve a otra stage primero. Borrar el User
// SÍ borra los contactos (Cascade) porque son su data privada.
model CrmContact {
  id             String   @id @default(uuid())
  ownerUserId    String
  ownerUser      User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  stageId        String
  stage          Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  // Todos opcionales por diseño — "no generar fricción al registrar".
  name           String?
  phone          String?
  instagram      String?
  address        String?
  description    String?  @db.Text
  // Etiquetas libres del afiliado (string[]). En C7 también traemos las
  // tags de Grow Business acá para automatizaciones de cambio de stage.
  tags           Json     @default("[]")
  // Timestamp de última actividad — se actualiza al crear, editar, mover
  // de stage, o al ejecutar un botón automático (C5). Sirve para ordenar
  // el kanban por "más reciente" y para mostrar el badge "Última actividad".
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  activities CrmActivity[]

  // F2: enrollments del contacto en secuencias del afiliado.
  sequenceEnrollments SequenceEnrollment[]

  // C7: si el contacto fue sincronizado desde una fuente externa
  // (Grow Business), guardamos el id externo para dedup en próximas
  // sincronizaciones. externalSource permite extender a otras integraciones
  // (HubSpot, Pipedrive, etc.) sin cambiar el schema.
  externalContactId String?
  externalSource    String?

  @@index([ownerUserId, stageId])
  @@index([ownerUserId, lastActivityAt])
  @@index([ownerUserId, externalContactId])
}

// Equipo de ventas (C4). Agrupación administrativa de afiliados/users
// gestionada por el super admin. NO comparte pipeline ni contactos —
// cada miembro mantiene su CRM propio (decisión confirmada por el user
// en planning: "solo ve sus contactos"). El equipo sirve para:
//   1. Métricas agregadas (C8: top equipos, conversiones por equipo).
//   2. Asignación a tenants (B3 + B5 pueden referirse a un equipo).
//   3. Lead del equipo puede ver dashboard agregado (C8).
//
// leadUserId es opcional — un equipo puede no tener lead designado
// (gestionado solo por super admin). onDelete SetNull preserva el
// equipo si el lead user es eliminado.
model SalesTeam {
  id         String   @id @default(uuid())
  name       String
  leadUserId String?
  leadUser   User?    @relation("SalesTeamLead", fields: [leadUserId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  members SalesTeamMember[]

  @@index([leadUserId])
}

// Membresía m2m User ↔ SalesTeam. Un user puede pertenecer a varios
// equipos (raro pero posible). joinedAt para auditoría.
model SalesTeamMember {
  id       String    @id @default(uuid())
  teamId   String
  team     SalesTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation("SalesTeamMember", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Canal de envío del botón automático del CRM (C5).
// - SMS:      envío server-side via Grow Business (integración real
//             llega en C7; por ahora se aplican solo los side effects).
// - WHATSAPP: el backend prepara el URL wa.me y el frontend lo abre en
//             nueva tab (no es envío real, es deep-link al WhatsApp
//             del afiliado).
// - EMAIL:    envío server-side via Resend (también pendiente full
//             integración).
// - NOTE:     no envía nada — solo aplica los side effects (mover
//             stage, agregar tags, lastActivityAt).
enum CrmButtonChannel {
  SMS
  WHATSAPP
  EMAIL
  NOTE
}

// Botón automático del CRM. Cada afiliado configura sus propios botones
// (decisión confirmada en planning). Ejemplo: "Reunión finalizada" que
// envía un PDF, mueve a "Seguimiento" y coloca etiqueta
// [reunion-finalizada]. Tokens soportados en messageBody:
// {{name}}, {{phone}}, {{instagram}}, {{stage}}.
model CrmButton {
  id                   String           @id @default(uuid())
  ownerUserId          String
  ownerUser            User             @relation("CrmButtonOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name                 String
  color                String           @default("#6366F1")
  icon                 String? // emoji o texto corto
  order                Int
  channel              CrmButtonChannel
  messageBody          String?          @db.Text
  attachmentUrl        String? // URL R2
  attachmentName       String? // nombre original mostrable
  // Side effects al ejecutar.
  moveToStageId        String? // si está set, mueve el contacto a esta stage
  moveToStage          Stage?           @relation("CrmButtonMoveStage", fields: [moveToStageId], references: [id], onDelete: SetNull)
  addTags              Json             @default("[]")
  // Delay en segundos antes de ejecutar (default 0 = inmediato).
  // En C5 el delay se guarda pero NO se respeta — la ejecución es
  // inmediata. Implementar delay con BullMQ se posterga a una
  // iteración posterior cuando haya queue infrastructure.
  delaySeconds         Int              @default(0)
  requiresConfirmation Boolean          @default(true)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([ownerUserId, order])
}

// Tipo de actividad registrada en el timeline de un contacto.
// El frontend renderea cada tipo con un ícono + label distintos.
enum CrmActivityType {
  CONTACT_CREATED // contacto creado (auto al crearse)
  CONTACT_UPDATED // edición de campos básicos (name/phone/instagram/etc)
  STAGE_CHANGED // movido de columna (drag&drop o select)
  BUTTON_EXECUTED // botón automático ejecutado (C5)
  NOTE_ADDED // nota manual del afiliado
  TAG_ADDED // tag agregado (manual o via botón)
}

// Historial completo del contacto (C6). Cada interacción se registra
// como una row separada para preservar el timeline auditable. Las
// CrmActivity se borran en cascade si se borra el contacto (data
// privada del afiliado) o si se borra el user que las generó. El
// frontend pinta esto como timeline vertical en el ContactDrawer.
model CrmActivity {
  id        String          @id @default(uuid())
  contactId String
  contact   CrmContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("CrmActivityUser", fields: [userId], references: [id], onDelete: Cascade)
  type      CrmActivityType
  title     String
  body      String?         @db.Text
  // metadata: payload específico según el type. Ejemplos:
  //   STAGE_CHANGED  → { fromStageId, fromStageName, toStageId, toStageName }
  //   BUTTON_EXECUTED → { buttonId, buttonName, channel, message, addedTags[] }
  //   TAG_ADDED      → { tags: [...] }
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now())

  @@index([contactId, createdAt])
}

// ============================================================
// SECUENCIAS / AUTOMATIZACIONES (Sequences)
// ============================================================
// Workflows tipo GHL / ActiveCampaign / Manychat: el afiliado define
// una secuencia de pasos (enviar mensaje → esperar 1h → enviar PDF →
// esperar 1 día → mover de stage → ...) y cuando un contacto cumple
// un trigger (entró al CRM, se movió a stage X, etc.) se enrolla y
// el engine ejecuta paso por paso con delay vía BullMQ.
//
// Decisiones:
// - Cada afiliado tiene SUS secuencias (ownerUserId). No se comparten.
// - Una secuencia tiene N steps ordenados (order int).
// - Un contacto puede estar enrollado en varias secuencias en paralelo.
// - El engine guarda `currentStepId` en el enrollment + un BullMQ jobId
//   por si necesitamos cancelar el delay programado.

enum SequenceTriggerKind {
  MANUAL // Disparado desde la UI (botón "Inscribir")
  CONTACT_CREATED // Al crearse un contacto del afiliado
  STAGE_CHANGED // Al moverse a una stage específica (config: {stageId})
  TAG_ADDED // Al agregar una tag específica (config: {tag})
  CONTACT_FROM_GB // Al sincronizar desde Grow Business
}

enum SequenceStepKind {
  SEND_MESSAGE
  WAIT
  MOVE_STAGE
  ADD_TAG
  REMOVE_TAG
  ASSIGN_USER
  END
}

enum SequenceMessageType {
  TEXT
  AUDIO
  VIDEO
  PDF
  IMAGE
}

// Canal de envío del mensaje. Email queda intencionalmente fuera —
// el user decidió quitarlo. WhatsApp por server-side via Grow Business
// llega en F6; por ahora ambos canales usan el mismo flujo (SMS real).
enum SequenceMessageChannel {
  SMS
  WHATSAPP
}

enum SequenceWaitUnit {
  MINUTES
  HOURS
  DAYS
  WEEKS
}

enum SequenceEnrollmentStatus {
  ACTIVE // En curso o esperando próximo step
  PAUSED // El user pausó manualmente
  COMPLETED // Llegó a END o ejecutó último step
  CANCELED // El user canceló
  FAILED // Error fatal (contacto sin teléfono, GB no conectado, etc.)
}

model Sequence {
  id          String   @id @default(uuid())
  ownerUserId String
  ownerUser   User     @relation("SequenceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  // isActive=false → no se enrollan nuevos contactos. Los enrollments
  // ya activos siguen corriendo (el user puede pausarlos individualmente).
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SequenceStep[]
  triggers    SequenceTrigger[]
  enrollments SequenceEnrollment[]

  @@index([ownerUserId, isActive])
}

// Un nodo del flow builder. `nextStepId` apunta al siguiente — esto
// permite branching futuro (un step podría tener múltiples siguientes
// según condición), por ahora linear. nodeX/nodeY son posición visual
// en el canvas del builder.
model SequenceStep {
  id         String           @id @default(uuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order      Int
  kind       SequenceStepKind

  // SEND_MESSAGE specific
  messageChannel SequenceMessageChannel?
  messageType    SequenceMessageType?
  messageBody    String?                 @db.Text
  attachmentUrl  String?
  attachmentName String?

  // WAIT specific
  waitAmount Int?
  waitUnit   SequenceWaitUnit?

  // MOVE_STAGE specific. SetNull → si la stage se borra, el step queda
  // sin destino y al ejecutarse hace skip.
  moveToStageId String?
  moveToStage   Stage?  @relation("SequenceStepMoveStage", fields: [moveToStageId], references: [id], onDelete: SetNull)

  // ADD_TAG / REMOVE_TAG specific. Array de strings.
  tags Json @default("[]")

  // ASSIGN_USER specific. SetNull → si el user assignee se borra, skip.
  assignToUserId String?
  assignToUser   User?   @relation("SequenceStepAssignee", fields: [assignToUserId], references: [id], onDelete: SetNull)

  // Posición visual en el flow builder (canvas xyflow).
  nodeX Float?
  nodeY Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollmentsHere SequenceEnrollment[] @relation("SequenceEnrollmentCurrentStep")

  @@index([sequenceId, order])
}

// Cuándo se enrolla automáticamente un contacto a la secuencia.
// config Json soporta:
//   STAGE_CHANGED → {stageId: string}
//   TAG_ADDED     → {tag: string}
// Otros triggers son self-contained (no requieren config).
model SequenceTrigger {
  id         String              @id @default(uuid())
  sequenceId String
  sequence   Sequence            @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  kind       SequenceTriggerKind
  config     Json                @default("{}")
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())

  @@index([sequenceId])
  @@index([kind, isActive])
}

// Un contacto enrollado en una secuencia. Si el contacto ya estaba
// enrollado y completó, puede volver a enrollarse (no hay unique
// [sequenceId, contactId] — el service decide si re-enrollar). El
// currentStepId apunta al PRÓXIMO step a ejecutar. jobId guarda el
// BullMQ job en cola por si hay que cancelar el delay.
model SequenceEnrollment {
  id            String                   @id @default(uuid())
  sequenceId    String
  sequence      Sequence                 @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId     String
  contact       CrmContact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status        SequenceEnrollmentStatus @default(ACTIVE)
  currentStepId String?
  currentStep   SequenceStep?            @relation("SequenceEnrollmentCurrentStep", fields: [currentStepId], references: [id], onDelete: SetNull)
  // Próxima ejecución programada. null cuando completó/canceló.
  nextRunAt     DateTime?
  // ID del job BullMQ programado. Cancelar con queue.remove(jobId).
  jobId         String?
  // Cómo se enrolló (manual o trigger automático).
  triggerKind   SequenceTriggerKind      @default(MANUAL)
  // Último error si FAILED.
  lastError     String?                  @db.Text
  enrolledAt    DateTime                 @default(now())
  completedAt   DateTime?
  updatedAt     DateTime                 @updatedAt

  executions SequenceExecution[]

  @@index([contactId])
  @@index([status, nextRunAt])
  @@index([sequenceId, status])
}

// Log auditable de cada step ejecutado. Sirve para mostrar timeline
// en la UI del contacto ("Recibió mensaje 'Bienvenida' el X de Y").
model SequenceExecution {
  id           String             @id @default(uuid())
  enrollmentId String
  enrollment   SequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String
  stepKind     SequenceStepKind
  // OK | FAILED | SKIPPED
  status       String
  // Mensaje renderizado al ejecutarse (post-substitución de variables).
  message      String?            @db.Text
  error        String?            @db.Text
  // Payload extra (added tags, moved-from-stage, etc.).
  metadata     Json               @default("{}")
  executedAt   DateTime           @default(now())

  @@index([enrollmentId, executedAt])
}

// ============================================================
//   COMMISSION EXCEPTIONS — item 6 sprint
// ============================================================

/// Excepción comercial de comisión para un tenant específico. Sobreescribe
/// el porcentaje normal de la cadena de afiliados (influencer/embajador/
/// vendedor) solo para ese tenant. Aplica a comisiones futuras + PENDING;
/// las ya PAID no se tocan salvo override manual del SUPER_ADMIN.
model CommissionException {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// El ReferralCode al que se le aplica la excepción (influencer/embajador/
  /// vendedor). Un mismo tenant puede tener excepciones distintas por cada
  /// rol en la cadena (ej: 20% para el embajador y 5% para el influencer).
  recipientCodeId String
  recipientCode   ReferralCode @relation(fields: [recipientCodeId], references: [id], onDelete: Cascade)
  customPercent   Decimal      @db.Decimal(5, 2)
  reason          String?      @db.Text
  isActive        Boolean      @default(true)
  createdById     String?
  createdBy       User?        @relation("CommissionExceptionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// Historial de cambios — un row nuevo por cada update.
  history CommissionExceptionHistory[]

  @@unique([tenantId, recipientCodeId])
  @@index([tenantId])
  @@index([recipientCodeId])
}

/// Snapshot audit del cambio de excepción — para responder "¿quién la
/// puso al 20%, cuándo y por qué?".
model CommissionExceptionHistory {
  id              String              @id @default(cuid())
  exceptionId     String
  exception       CommissionException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  previousPercent Decimal?            @db.Decimal(5, 2)
  newPercent      Decimal             @db.Decimal(5, 2)
  previousActive  Boolean?
  newActive       Boolean
  reason          String?             @db.Text
  changedById     String?
  changedBy       User?               @relation("CommissionExceptionHistoryChanger", fields: [changedById], references: [id], onDelete: SetNull)
  changedAt       DateTime            @default(now())

  @@index([exceptionId, changedAt])
}

// ============================================================
//                       CLUBIFY LAB (item 13 sprint)
// ============================================================
// Sistema de propuestas de comunidad. Clientes / embajadores / vendedores
// proponen mejoras → equipo Clubify revisa → propuestas aprobadas pasan a
// votación pública → las más votadas entran al roadmap.

enum LabCategory {
  CLIENTS /// Para negocios: tarjetas, Wallet, Delivery, QR, automatizaciones, etc.
  AFFILIATES /// Para embajadores/influencers/vendedores: CRM, comisiones, prospectos, etc.
}

enum LabPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum LabStatus {
  PENDING /// propuesta nueva, no pública aún
  REJECTED /// equipo rechazó (no pública)
  EVALUATING /// en evaluación pública post-aprobación
  APPROVED /// aprobada para roadmap
  IN_DEVELOPMENT /// en desarrollo
  IN_TESTING /// en pruebas
  IMPLEMENTED /// implementada
}

enum LabVoteKind {
  LIKE /// Me gusta
  NEED /// La necesito
  HIGH_PRIORITY /// Alta prioridad
  DISLIKE /// No la considero necesaria
}

model LabProposal {
  id                    String      @id @default(cuid())
  title                 String
  description           String      @db.Text
  category              LabCategory
  priority              LabPriority @default(MEDIUM)
  expectedBenefit       String?     @db.Text
  status                LabStatus   @default(PENDING)
  /// URL de un adjunto opcional (imagen/PDF/video subido a R2).
  attachmentUrl         String?
  attachmentKind        String? /// 'image' | 'pdf' | 'video' | 'document'
  authorId              String
  author                User        @relation("LabProposalAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  /// Si fue rechazada, motivo opcional para el autor.
  rejectionReason       String?     @db.Text
  /// Counter denormalizado (sino las queries de "top votadas" se hacen lentas).
  votesScore            Int         @default(0)
  votesCount            Int         @default(0)
  commentsCount         Int         @default(0)
  /// Snapshot del último admin que cambió status (para mostrar quién lo movió).
  lastStatusChangedById String?
  lastStatusChangedBy   User?       @relation("LabProposalLastStatusChanger", fields: [lastStatusChangedById], references: [id], onDelete: SetNull)
  lastStatusChangedAt   DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  votes    LabVote[]
  comments LabComment[]

  @@index([category, status, votesScore])
  @@index([authorId])
}

model LabVote {
  id         String      @id @default(cuid())
  proposalId String
  proposal   LabProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       LabVoteKind
  createdAt  DateTime    @default(now())

  @@unique([proposalId, userId])
  @@index([proposalId, kind])
}

model LabComment {
  id         String      @id @default(cuid())
  proposalId String
  proposal   LabProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  authorId   String
  author     User        @relation("LabCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String      @db.Text
  createdAt  DateTime    @default(now())

  @@index([proposalId, createdAt])
}

// ============================================================
//                  DIFUSIÓN INTERNA / BROADCASTS
// ============================================================

enum BroadcastKind {
  BANNER /// barra arriba del panel afiliado
  LOGIN_POPUP /// popup al iniciar sesión
}

enum BroadcastAudience {
  ALL
  INFLUENCERS
  AMBASSADORS
  VENDORS
}

enum BroadcastColor {
  GREEN
  BLUE
  YELLOW
  RED
  CUSTOM
}

enum BroadcastIcon {
  INFO
  ALERT
  NEWS
  TRAINING
  PROMO
}

enum BroadcastMediaKind {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  PDF
}

model Broadcast {
  id          String            @id @default(cuid())
  kind        BroadcastKind
  title       String
  description String            @db.Text
  audience    BroadcastAudience @default(ALL)
  isActive    Boolean           @default(true)

  /// Solo para BANNER
  color       BroadcastColor?
  customColor String? /// hex si color=CUSTOM
  icon        BroadcastIcon?
  ctaLabel    String?
  ctaUrl      String?

  /// Solo para LOGIN_POPUP
  mediaKind    BroadcastMediaKind?
  mediaUrl     String? /// URL a R2 (imagen/audio/video/PDF)
  /// Texto del botón principal del popup (ej. "He leído", "Entendido").
  confirmLabel String?             @default("He leído")

  /// Ventana de vigencia opcional.
  startsAt DateTime?
  endsAt   DateTime?

  createdById String?
  createdBy   User?    @relation("BroadcastCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reads BroadcastRead[]

  @@index([kind, isActive])
  @@index([audience])
}

model BroadcastRead {
  id          String    @id @default(cuid())
  broadcastId String
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt      DateTime  @default(now())

  @@unique([broadcastId, userId])
  @@index([userId])
}

// ============================================================
//                    FASE D — PAGO DE COMISIONES
// ============================================================
//
// Sistema completo de pago a afiliados (influencer/embajador/vendedor/
// socio): el afiliado llena su perfil de pago (Binance o cuenta
// bancaria), el SUPER_ADMIN lo aprueba, y cuando la persona acumula
// >= 50 USD de comisiones APPROVED entra en la lista "Listo por pagar"
// del panel admin. Al transferir, el admin crea un CommissionPayout con
// las commissions afectadas + sube comprobante (imagen/PDF) a R2.
//
// Día oficial de pago: 15 de cada mes (countdown en panel afiliado).

model PaymentProfile {
  id               String               @id @default(uuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           PaymentProfileStatus @default(NONE)
  // Datos del titular (común a ambos métodos).
  firstName        String?
  lastName         String?
  phoneCountry     String? // ej: "+57"
  phone            String? // ej: "3001112233"
  method           PaymentMethodKind?
  // BINANCE
  binanceEmail     String?
  binancePhone     String? // opcional
  binanceNote      String? // observación opcional
  // BANK
  bankCountry      String?
  bankName         String?
  bankAccountType  String? // "ahorros" | "corriente" | etc
  bankAccountNo    String?
  bankHolderName   String?
  bankHolderDoc    String? // doc del titular (opcional)
  bankNote         String? // observación opcional
  // Razón de rechazo si status = REJECTED. Visible al afiliado para
  // que corrija (el SUPER_ADMIN la setea desde el panel admin).
  rejectionReason  String?              @db.Text
  reviewedByUserId String?
  reviewedBy       User?                @relation("PaymentProfileReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status])
}

model CommissionPayout {
  id              String                 @id @default(uuid())
  // El afiliado que recibe el pago.
  recipientUserId String
  recipientUser   User                   @relation("CommissionPayoutRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  // amount = BRUTO (suma de comisiones). feeUsd = costo de retiro (3 si el
  // bruto < 50, sino 0). netUsd = lo efectivamente transferido (bruto − fee).
  // Spec costo de retiro 2026-06-15. Nullable/default para backwards-compat.
  amount          Decimal                @db.Decimal(10, 2)
  feeUsd          Decimal                @default(0) @db.Decimal(10, 2)
  netUsd          Decimal?               @db.Decimal(10, 2)
  currency        String                 @default("USD")
  status          CommissionPayoutStatus @default(PROCESSING)
  // Snapshot del método al momento del pago (Binance / Bank) para que
  // si después el afiliado cambia su perfil, el histórico no se mute.
  methodSnapshot  Json
  // Comprobante subido a R2. URL pública del bucket. El admin lo sube
  // como imagen o PDF; null hasta que se adjunte.
  proofUrl        String?
  proofMimeType   String?
  // Quién marcó el pago como hecho (admin).
  paidByUserId    String?
  paidBy          User?                  @relation("CommissionPayoutPaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  paidAt          DateTime?
  notes           String?                @db.Text
  items           CommissionPayoutItem[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([recipientUserId])
  @@index([status])
}

// Tabla puente Commission <-> Payout. Unique en commissionId garantiza
// que una commission solo entra en un payout (sin doble cobro).
model CommissionPayoutItem {
  id           String           @id @default(uuid())
  payoutId     String
  payout       CommissionPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commissionId String           @unique
  commission   Commission       @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  // Snapshot del monto al momento del payout (la commission podría
  // cambiar de amount después de un ajuste manual del admin).
  amount       Decimal          @db.Decimal(10, 2)
  createdAt    DateTime         @default(now())

  @@index([payoutId])
}

// ============================================================
//                    PLATAFORMA / MASTER ADMIN (Nivel 1)
// ============================================================
//
// La PLATAFORMA (p.ej. "Fidelia") es el nivel superior del SaaS.
// Vende el motor de fidelización a Marcas Blancas (Nivel 2 — Clubify
// es una de ellas). Cada Marca Blanca opera bajo su propio dominio,
// branding y créditos, y gestiona sus propios negocios (Nivel 3 =
// el actual modelo Tenant).
//
// Aislamiento absoluto: una marca blanca nunca ve datos de otra. El
// PLATFORM_OWNER (Mauricio, etc.) es el único con visión global.

model WhiteLabel {
  id                       String           @id @default(uuid())
  name                     String // "Clubify", "LoyalMX", etc.
  slug                     String           @unique // "clubify", "loyalmx"
  /// Dominio principal de marketing/landing (ej "clubify.app").
  domain                   String?
  /// Dominio del panel de cuenta (ej "app.clubify.app").
  appDomain                String?
  /// Color hex del avatar / botones primarios de la marca.
  primaryColor             String           @default("#16a34a")
  /// API key de Google Maps (browser key, restringida por referrer en el Google
  /// Cloud de la marca). El mapa del panel la usa; sin ella cae a la env global
  /// de Clubify. Es una key pública (se expone al cliente), no un secreto.
  mapsApiKey               String?
  /// Subcuenta de Grow Business (GoHighLevel) de la MARCA. TODOS los SMS de los
  /// negocios de esta marca (cobros, domicilio, reseñas) salen de acá cuando el
  /// negocio no tiene creds propias — nunca de la cuenta de Clubify. apiKey se
  /// guarda CIFRADO (secret-box). switchNumber = prioridad del número (opcional).
  growBusinessLocationId   String?
  growBusinessApiKey       String?
  growBusinessSwitchNumber Int?
  /// Identidad visual extendida de la marca (manual de marca). Todos opcionales.
  /// Logo HEADER (lockup horizontal ~3:1) — landing, login y páginas públicas.
  logoUrl                  String?
  /// Logo DASHBOARD (cuadrado ~1:1) — sidebar/header del panel admin. Si no
  /// hay, cae a logoUrl y, en última instancia, al avatar de inicial.
  iconUrl                  String?
  /// Favicon (cuadrado) — pestaña del navegador + PWA. Cae a iconUrl/logoUrl.
  faviconUrl               String?
  /// Imagen de previsualización al compartir el enlace de la marca (Open Graph /
  /// Twitter Card) en WhatsApp/redes. Si null, se usa el logo de la marca; nunca
  /// la imagen de Clubify. Recomendado 1200×630.
  shareImageUrl            String?
  /// Color secundario / tinta (textos y fondos oscuros).
  secondaryColor           String?
  /// Color de fondos suaves (crema).
  backgroundColor          String?
  /// Color de apoyo / accent oscuro.
  supportColor             String?
  /// Handle de Instagram público (ej "@selleala").
  instagram                String?
  /// Email de contacto público de la marca (ej "hola@selleala.com").
  contactEmail             String?
  /// Letra inicial mostrada en el avatar cuadrado.
  initial                  String?
  /// WhatsApp del botón "Agendar demo" de la landing de la marca (ej.
  /// "+17865832760"). Si null, la landing usa su fallback. NO hardcodear el
  /// número en la página — cada marca define el suyo acá.
  demoButtonWhatsApp       String?
  /// Enlace de conexión de WhatsApp de la marca (ej. proveedor tipo wazzap.mx:
  /// "https://app.wazzap.mx/u/<uuid>"). Lo pega el super admin en /superadmin.
  /// El panel /admin de la marca genera un QR con este enlace (Automatizaciones
  /// → QR WhatsApp) para que el dueño lo escanee y vincule su WhatsApp. El link
  /// NO se muestra como texto; solo el QR.
  whatsappQrUrl            String?
  /// Email del admin principal (queda informativo; los logins reales son
  /// User con role SUPER_ADMIN o TENANT_OWNER bajo esta marca).
  adminEmail               String?
  status                   WhiteLabelStatus @default(ACTIVE)

  /// Pasarela de pago activa de la marca. Cada marca cobra de forma
  /// independiente con SU propia cuenta. HOTMART | STRIPE | MANUAL.
  /// MANUAL = sin cobro automático (activaciones/suspensiones a mano).
  paymentGateway PaymentGateway @default(HOTMART)
  /// Config de la pasarela (Json). Secretos guardados CIFRADOS (enc:v1:...);
  /// campos no-secretos en plano. Forma por gateway:
  ///   HOTMART: { apiKey, clientId, clientSecret, webhookSecret, webhookUrl, productCode }
  ///   STRIPE:  { publishableKey, secretKey, webhookSecret, webhookUrl, customerPortalUrl }
  /// Nunca se devuelve en plano al frontend: los secretos van enmascarados.
  paymentConfig  Json?

  /// Créditos disponibles para gastar en activaciones / renovaciones
  /// de sus negocios. 1 crédito = 30 días de servicio. Acumulativos,
  /// no vencen. Se descuentan automáticamente.
  creditsAvailable Int     @default(0)
  /// Créditos comprometidos (negocios próximos a renovar dentro de la
  /// ventana). Calculado por proceso periódico.
  creditsCommitted Int     @default(0)
  /// Créditos usados acumulados (auditoría).
  creditsUsed      Int     @default(0)
  /// Si está en true, la marca tiene créditos ilimitados — el cron de
  /// renovaciones no le descuenta y los packs Hotmart que matchean su
  /// adminEmail se ignoran (la compra queda como ASSIGNED igual, pero
  /// no incrementa creditsAvailable). Para partners especiales o demos.
  creditsUnlimited Boolean @default(false)

  /// Periodicidades de plan que ofrece la marca (MENSUAL/TRIMESTRAL/SEMESTRAL/
  /// ANUAL). Configurable por marca en Master Admin → controla qué opciones de
  /// periodicidad muestra el form "Nuevo negocio". Default = las 4 (Clubify).
  planPeriodicities String[] @default(["MENSUAL", "TRIMESTRAL", "SEMESTRAL", "ANUAL"])

  /// Features que la marca incluye en su suscripción → la lista "Tu suscripción
  /// incluye" del panel de billing muestra SOLO estas (keys i18n, ej.
  /// "featUnlimitedOrders"). Vacío = lista completa por defecto (Clubify). Cada
  /// marca define qué ofrece su plan; nunca se muestran features que no incluye.
  subscriptionFeatureKeys String[] @default([])

  /// Wallet V3 — bloque "Wallet Avanzado". Permisos de la marca sobre las
  /// funciones nuevas de Wallet. Objeto con claves booleanas:
  ///   { customBackgrounds, freeRewards, removeStamps, showNextReward,
  ///     showHistory, showAudit }
  /// Semántica de HERENCIA: null o clave ausente = ACTIVADA (las mejoras se
  /// heredan automáticamente a todas las marcas). Una marca DESACTIVA poniendo
  /// la clave en false → sus negocios no podrán usar esa función. A nivel
  /// negocio siguen siendo opt-in por tarjeta (no cambian tarjetas actuales).
  /// Aislamiento: se lee/escribe SIEMPRE por whiteLabelId (modelo sin tenantId).
  walletAdvanced          Json?

  /// Costo de instalación/implementación (USD) mostrado en la página de precios
  /// de la marca. Null = no se muestra línea de instalación.
  installationFeeUsd      Decimal? @db.Decimal(10, 2)
  /// Precio PROMOCIONAL de instalación (USD). Si está, la página muestra el fee
  /// original tachado y este como "PRECIO PROMOCIONAL", y lo suma al total hoy.
  installationPromoUsd    Decimal? @db.Decimal(10, 2)

  /// Teléfono al que la plataforma (Clubify) le manda los SMS de créditos
  /// a esta marca blanca (compra acreditada / saldo bajo / negocios
  /// pendientes por falta de créditos). El remitente es la subcuenta global
  /// de Grow Business de Clubify. Null = no se le notifica por SMS.
  notifyPhone              String?
  /// Marca de tiempo del último SMS "saldo bajo (≤2 créditos)" enviado. Se
  /// limpia (null) al recargar créditos para poder volver a avisar. Evita
  /// spamear el mismo aviso en cada consumo.
  lowCreditsNotifiedAt     DateTime?
  /// Marca de tiempo del último SMS "tenés negocios pendientes por falta de
  /// créditos". Se limpia al recargar / cuando ya no hay pendientes.
  pendingClientsNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones — todo lo "scoped" a una marca blanca cuelga de acá.
  tenants                Tenant[]
  modules                WhiteLabelModule[]
  knowledgeEntries       KnowledgeEntry[]        @relation("WhiteLabelKnowledge")
  referralCodes          ReferralCode[]          @relation("WhiteLabelReferralCodes")
  creditTransactions     CreditTransaction[]
  /// Users con role SUPER_ADMIN vinculados directamente a esta marca
  /// (no atados a un tenant específico). Ven todos los tenants de la
  /// marca, gestionan branding, etc. Es la cuenta admin "de la marca".
  admins                 User[]                  @relation("WhiteLabelAdmin")
  adminInvites           WhiteLabelAdminInvite[]
  hotmartCreditPurchases HotmartCreditPurchase[]
  hotmartCreditLinks     HotmartCreditLink[]     @relation("WhiteLabelCreditLinks")
  businessGroups         BusinessGroup[]         @relation("WhiteLabelGroups")
  paymentLinks           WhiteLabelPaymentLink[]
  // Red de Domicilios (Fase 1, 2026-06-29): empresas logísticas que "pertenecen"
  // a la marca + marcas donde una empresa (de cualquier dueño) está habilitada.
  deliveryCompanies      DeliveryCompany[]
  deliveryCompanyBrands  DeliveryCompanyBrand[]
  // Cuponera / Living Card: campañas de beneficios comunitarios de la marca.
  benefitCampaigns       BenefitCampaign[]
  // Academia interactiva: videos-tutorial de YouTube por módulo (por marca).
  academyVideos          AcademyVideo[]

  @@index([status])
}

/// Academia interactiva — video-tutorial (enlace YouTube) por MÓDULO y por
/// MARCA BLANCA. Cada marca administra SOLO sus enlaces (aislado por
/// whiteLabelId). `moduleKey` es la clave única del módulo (wallet, clientes,
/// push, …); agregar/editar un video = un registro, sin tocar el frontend.
/// El botón "▶ Ver tutorial" solo aparece si existe una fila active=true con
/// youtubeUrl para ese (marca, módulo).
model AcademyVideo {
  id           String     @id @default(uuid())
  whiteLabelId String
  whiteLabel   WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  /// Clave del módulo (slug estable): wallet, clientes, push, reviews, agenda…
  moduleKey    String
  /// Enlace de YouTube pegado por el admin de la marca (watch/youtu.be/shorts).
  youtubeUrl   String     @default("")
  /// Si false, el botón NO aparece (queda invisible, no deshabilitado).
  active       Boolean    @default(true)
  /// Título del popup. Vacío → el frontend usa el nombre del módulo.
  title        String     @default("")
  /// Descripción opcional bajo el video.
  description  String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([whiteLabelId, moduleKey])
  @@index([whiteLabelId])
}

// ─────────────────────────────────────────────────────────────────────────
// RED DE DOMICILIOS (Fase 1 — 2026-06-29)
// Empresas logísticas que entregan los pedidos de ciertos negocios. Las crea
// el Master Admin. El seguimiento logístico vive en `Delivery` (1:1 con Order)
// para NO tocar el ciclo de `Order.status` que ya funciona.
// ─────────────────────────────────────────────────────────────────────────

/// Empresa de domicilios. La crea/gestiona el Master Admin. Opera para las
/// marcas (`brands`) y negocios (`tenants`) que se le habiliten.
model DeliveryCompany {
  id                    String      @id @default(uuid())
  /// Marca blanca "dueña" de la gestión de esta empresa (informativo / scoping
  /// del Master Admin de marca). Las marcas/negocios donde realmente opera se
  /// definen en `brands`/`tenants`. Null = gestionada por Clubify (plataforma).
  whiteLabelId          String?
  whiteLabel            WhiteLabel? @relation(fields: [whiteLabelId], references: [id], onDelete: SetNull)
  name                  String
  logoUrl               String?
  whatsapp              String?
  city                  String?
  /// Nombre del responsable / contacto de la empresa.
  responsible           String?
  email                 String?
  /// Comisión FIJA de la plataforma por domicilio entregado (Fase 4). Es lo que
  /// la empresa "aporta" por entrega; la empresa se queda con el valor del
  /// domicilio que le cobra al cliente. USD. Null/0 = no genera comisión.
  commissionPerDelivery Decimal?    @db.Decimal(10, 2)
  /// % de esa comisión que va a la MARCA BLANCA del negocio; el resto va al
  /// Master Admin. Configurable por empresa (Fase 4). Default 0 = todo al Master.
  brandSharePct         Int         @default(0)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  brands           DeliveryCompanyBrand[]
  tenants          DeliveryCompanyTenant[]
  deliveries       Delivery[]
  /// Cuentas de login (role=DELIVERY_COMPANY) que operan esta empresa (Fase 2).
  admins           User[]                   @relation("DeliveryCompanyAdmin")
  commissions      DeliveryCommission[]
  /// Chat directo negocio↔empresa (por negocio, no por pedido). PDF 1254.
  businessMessages DeliveryCompanyMessage[]
  /// Flota de motos/vehículos de la empresa (PDF245 P1).
  vehicles         DeliveryVehicle[]

  @@index([whiteLabelId])
  @@index([isActive])
}

/// Marca blanca habilitada para una empresa de domicilios (una empresa puede
/// operar para varias marcas).
model DeliveryCompanyBrand {
  id                String          @id @default(uuid())
  deliveryCompanyId String
  deliveryCompany   DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  whiteLabelId      String
  whiteLabel        WhiteLabel      @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)

  @@unique([deliveryCompanyId, whiteLabelId])
  @@index([whiteLabelId])
}

/// Negocio habilitado para una empresa de domicilios (acota a ciertos negocios).
model DeliveryCompanyTenant {
  id                String          @id @default(uuid())
  deliveryCompanyId String
  deliveryCompany   DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([deliveryCompanyId, tenantId])
  @@index([tenantId])
}

/// Seguimiento logístico de un pedido (1:1 con Order). Los estados de cocina
/// (recibido/preparando/listo) siguen en `Order.status`; aquí viven los estados
/// del repartidor + datos del conductor + valor del domicilio.
model Delivery {
  id                String           @id @default(uuid())
  orderId           String           @unique
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryCompanyId String?
  deliveryCompany   DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  /// Moto de la flota asignada al domicilio (PDF245 P1). Los campos courier*
  /// quedan como snapshot poblado desde la moto elegida.
  vehicleId         String?
  vehicle           DeliveryVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  status        DeliveryStatus @default(WAITING_COURIER)
  /// Datos que registra la empresa (Fase 2): repartidor, dirección, precio.
  courierName   String?
  courierPhone  String?
  courierPlate  String?
  etaMinutes    Int?
  address       String?
  /// Valor del domicilio. Se registra en Fase 1; las comisiones (split
  /// empresa/marca/master) llegan en la Fase 4. USD.
  deliveryValue Decimal?       @db.Decimal(10, 2)

  // Timestamps por estado.
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  onTheWayAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  commission DeliveryCommission?

  @@index([tenantId, status])
  @@index([deliveryCompanyId, status])
  @@index([vehicleId])
}

/// Moto/vehículo de la flota de una empresa de domicilios (PDF245 P1). La
/// empresa gestiona su flota desde el portal y elige una moto al asignar un
/// domicilio; solo debe indicar el ETA ("Tiempo estimado de entrega").
model DeliveryVehicle {
  id                String          @id @default(cuid())
  deliveryCompanyId String
  company           DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  /// Placa de la moto.
  plate             String
  /// Nombre del conductor.
  driverName        String
  driverPhone       String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  deliveries Delivery[]

  @@index([deliveryCompanyId, isActive])
}

// ─── Reservas de SERVICIOS (citas/agenda) — PDF245 P7 ───
// Distinto de las reservas de MESA. Un cliente agenda un Service (duración fija)
// en un slot disponible. MVP: disponibilidad a nivel NEGOCIO (sin profesional).

/// Servicio agendable (ej. "Corte de cabello", 30 min).
model Service {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  durationMin Int      @default(30)
  priceCents  Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  @@index([tenantId, isActive])
}

/// Horario semanal disponible del negocio (una fila por franja). Tiempos en
/// minutos desde medianoche en la timezone del tenant (ej. 540=09:00, 1080=18:00).
model ServiceAvailability {
  id         String   @id @default(cuid())
  tenantId   String
  /// Profesional dueño de la franja (Fase 5). null = disponibilidad a nivel
  /// NEGOCIO (cuando no hay profesionales configurados).
  providerId String?
  weekday    Int // 0=domingo … 6=sábado
  startMin   Int
  endMin     Int
  createdAt  DateTime @default(now())

  @@index([tenantId, providerId, weekday])
}

/// Profesional que atiende citas (barbero/estilista) — Fase 5. Cada uno tiene
/// su propia disponibilidad y agenda.
model ServiceProvider {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  /// Servicios que realiza (ids de Service). Vacío = hace TODOS. Fase 5 extra.
  serviceIds String[] @default([])
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, isActive])
}

/// Excepción para un día puntual: cerrado todo el día o con horario especial.
model ServiceException {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @db.Date
  closed    Boolean  @default(true)
  startMin  Int?
  endMin    Int?
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
}

/// Cita agendada. startAt/endAt en UTC (instante absoluto). status =
/// pending|confirmed|completed|cancelled|no_show.
model Appointment {
  id             String    @id @default(cuid())
  tenantId       String
  serviceId      String
  service        Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Profesional asignado (Fase 5). null = negocio sin profesionales.
  providerId     String?
  customerId     String?
  customerName   String
  customerPhone  String
  startAt        DateTime
  endAt          DateTime
  status         String    @default("confirmed")
  notes          String?
  /// Token para que el cliente gestione (reagendar/cancelar) su cita — Fase 5.
  manageToken    String?   @unique
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, startAt])
  @@index([serviceId, startAt])
  @@index([providerId, startAt])
}

/// Token de integración POR NEGOCIO (Onboarding Sync API, Fase B). Permiso
/// ÚNICO sobre su `tenantId` — nunca una API key global. Se guarda solo el
/// sha256 del token (`tokenHash`); el valor en claro se muestra una vez al
/// generarlo. Se revoca con `revokedAt`. Autenticación: `Authorization: Bearer <token>`.
model OnboardingToken {
  id         String    @id @default(uuid())
  tenantId   String
  /// sha256 (hex) del token en claro. El claro nunca se persiste.
  tokenHash  String    @unique
  /// Etiqueta libre para distinguir varios tokens del mismo negocio.
  label      String    @default("Onboarding")
  /// Últimos 4 caracteres del token en claro — para reconocer cuál es en la lista.
  lastFour   String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([tenantId])
}

/// Comisión de plataforma generada por un domicilio ENTREGADO (Fase 4). Monto
/// FIJO por empresa (DeliveryCompany.commissionPerDelivery), repartido entre la
/// marca blanca y el Master Admin según brandSharePct (snapshot). 1 por delivery.
model DeliveryCommission {
  id                String                   @id @default(uuid())
  deliveryId        String                   @unique
  delivery          Delivery                 @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  orderId           String
  deliveryCompanyId String?
  deliveryCompany   DeliveryCompany?         @relation(fields: [deliveryCompanyId], references: [id], onDelete: SetNull)
  /// Marca blanca del negocio (snapshot) — para reportes por marca. Null = Clubify.
  whiteLabelId      String?
  /// Monto total de la comisión (= commissionPerDelivery al momento). USD.
  amount            Decimal                  @db.Decimal(10, 2)
  /// Parte para la marca blanca y parte para el Master Admin (suman amount).
  brandAmount       Decimal                  @db.Decimal(10, 2)
  masterAmount      Decimal                  @db.Decimal(10, 2)
  currency          String                   @default("USD")
  status            DeliveryCommissionStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime                 @default(now())

  @@index([deliveryCompanyId, status])
  @@index([whiteLabelId, status])
  @@index([status, createdAt])
}

enum DeliveryCommissionStatus {
  PENDING
  PAID
}

/// Mensaje del chat de un domicilio (Fase 3B — 2026-06-30). Hilo por pedido,
/// compartido por las 3 partes: cliente, negocio y empresa de domicilios.
model DeliveryMessage {
  id         String           @id @default(uuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderRole DeliveryChatRole
  /// Nombre mostrado del emisor (cliente / negocio / empresa) — snapshot.
  senderName String?
  body       String
  createdAt  DateTime         @default(now())

  @@index([orderId, createdAt])
}

/// Chat DIRECTO negocio↔empresa de domicilios, a nivel de NEGOCIO (no por
/// pedido). PDF 1254: la empresa ve una conversación por cada negocio que
/// atiende, y el negocio un canal directo con su empresa asignada.
model DeliveryCompanyMessage {
  id                String           @id @default(uuid())
  deliveryCompanyId String
  deliveryCompany   DeliveryCompany  @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Solo BUSINESS | COMPANY en este canal (el cliente no participa).
  senderRole        DeliveryChatRole
  senderName        String?
  body              String
  createdAt         DateTime         @default(now())

  @@index([deliveryCompanyId, tenantId, createdAt])
  @@index([tenantId, createdAt])
}

/// Quién envía un mensaje del chat de domicilio.
enum DeliveryChatRole {
  CUSTOMER
  BUSINESS
  COMPANY
}

/// Estados logísticos del repartidor (Order.status cubre recibido/preparando/listo).
enum DeliveryStatus {
  WAITING_COURIER // Esperando domiciliario (pedido listo, sin moto asignada)
  COURIER_ASSIGNED // Moto asignada
  PICKED_UP // Pedido recogido
  ON_THE_WAY // En camino
  DELIVERED // Entregado
  CANCELLED // Cancelado
}

enum WhiteLabelStatus {
  ACTIVE
  SUSPENDED
}

/// Pasarela de pago de una marca blanca. MANUAL = sin cobro automático.
enum PaymentGateway {
  HOTMART
  STRIPE
  MANUAL
  /// Cuponera / Living Card: suscripción recurrente de membresías (preapproval).
  MERCADOPAGO
}

/// Periodicidad de un link/plan de pago. CUSTOM = link personalizado.
enum PaymentLinkPeriodicity {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  CUSTOM
}

/// Link de pago (plan) de una marca blanca. Soporta múltiples por marca
/// (mensual/trimestral/semestral/anual/personalizado) — punto 9 del spec.
/// Aislado por whiteLabelId: nunca se mezclan links entre marcas.
model WhiteLabelPaymentLink {
  id              String                 @id @default(uuid())
  whiteLabelId    String
  whiteLabel      WhiteLabel             @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  /// Pasarela a la que pertenece el link (debe coincidir con la de la marca).
  gateway         PaymentGateway
  /// Nombre del plan visible ("Mensual", "Anual", "Promo lanzamiento").
  name            String
  periodicity     PaymentLinkPeriodicity @default(MENSUAL)
  /// Monto en USD (referencia / display). La cobranza real la define la URL.
  amountUsd       Decimal                @db.Decimal(10, 2)
  /// URL de pago (checkout Hotmart o Stripe Payment Link / Checkout).
  url             String?
  active          Boolean                @default(true)
  sortOrder       Int                    @default(0)
  /// Solo Stripe: identifican el precio/producto para mapear el webhook.
  stripePriceId   String?
  stripeProductId String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([whiteLabelId])
  @@index([stripePriceId])
}

/// Estado financiero de un Grupo Empresarial.
///  - ACTIVE: pago al día → todos sus negocios activos.
///  - PAST_DUE: pago pendiente → negocios siguen funcionando en gracia.
///  - SUSPENDED: pago no recuperado → todos sus negocios suspendidos.
enum BusinessGroupStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
}

/// Grupo Empresarial: agrupa varios Tenant (negocios) bajo un mismo cliente
/// responsable y UNA sola suscripción Hotmart. El estado financiero del grupo
/// cascadea al status de todos sus negocios. Aislado por marca (whiteLabelId).
model BusinessGroup {
  id                    String              @id @default(uuid())
  /// Marca dueña del grupo. Null = Clubify (plataforma). Aislamiento estricto.
  whiteLabelId          String?
  whiteLabel            WhiteLabel?         @relation("WhiteLabelGroups", fields: [whiteLabelId], references: [id], onDelete: SetNull)
  name                  String
  responsibleName       String?
  responsibleEmail      String?
  responsiblePhone      String?
  /// Código de suscripción Hotmart del grupo (fuente de verdad del cobro).
  hotmartSubscriberCode String?
  planPeriodicity       String?
  /// Precio REAL que paga el grupo por periodo (no-canónico). Un grupo suele
  /// ser N negocios × su mensualidad (ej: 3 × $50 = $150 MENSUAL). Base de la
  /// comisión (%×priceUsd) y del facturado. Null → cae al canónico de la
  /// periodicidad. (2026-07-02)
  priceUsd              Decimal?            @db.Decimal(10, 2)
  currentPeriodEnd      DateTime?
  status                BusinessGroupStatus @default(ACTIVE)
  failedPaymentCount    Int                 @default(0)
  suspendedAt           DateTime?
  lastChargeAt          DateTime?
  /// Recipiente de la comisión del grupo (Punto 2, 2026-07-01): afiliado
  /// (influencer/embajador/vendedor) que cobra %×bruto en cada cobro del grupo.
  /// Null = el grupo no genera comisión.
  referralCodeId        String?
  referralCode          ReferralCode?       @relation("BusinessGroupRecipient", fields: [referralCodeId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  tenants               Tenant[]
  commissions           Commission[]

  @@index([whiteLabelId])
  @@index([hotmartSubscriberCode])
  @@index([referralCodeId])
}

/// Módulos toggleables por marca blanca. Si está deshabilitado, los
/// negocios bajo esa marca NO ven el módulo en su sidebar ni en el
/// flujo. Catálogo cerrado: REFERIDOS / PEDIDOS / GROW_BUSINESS_SMS
/// (puede crecer luego).
model WhiteLabelModule {
  id           String     @id @default(uuid())
  whiteLabelId String
  whiteLabel   WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  module       ModuleKey
  enabled      Boolean    @default(true)
  updatedAt    DateTime   @updatedAt

  @@unique([whiteLabelId, module])
  @@index([module])
}

enum ModuleKey {
  REFERRALS
  ORDERS
  GROW_BUSINESS_SMS
  REVIEWS
  // Reservas de servicios (citas/agenda para barberías, spas, peluquerías,
  // clínicas…). PDF245 P7. Distinto de las reservas de MESA.
  SERVICE_RESERVATIONS
  // Sección Comunidad / Lab / Tutoriales. Habilitado solo para Clubify por
  // ahora; cada marca blanca lo enciende/apaga por config (sin tocar código).
  COMMUNITY
}

/// Ledger de movimientos de créditos por marca blanca. Cada compra,
/// consumo, compromiso o devolución queda registrado. Audit + soporte.
model CreditTransaction {
  id           String                @id @default(uuid())
  whiteLabelId String
  whiteLabel   WhiteLabel            @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  type         CreditTransactionType
  amount       Int // positivo en compra, negativo en consumo
  note         String?               @db.Text
  /// ID del negocio (Tenant) si el movimiento se aplicó por una renovación
  /// específica. Null para compras manuales y ajustes administrativos.
  tenantId     String?
  createdAt    DateTime              @default(now())

  @@index([whiteLabelId, createdAt])
}

enum CreditTransactionType {
  PURCHASE
  CONSUME
  COMMIT
  REFUND
  ADJUSTMENT
}

/// Links públicos de Hotmart (pago único, sin recurrencia) para comprar
/// packs de créditos. El admin de la marca blanca los muestra a sus
/// clientes; el dueño de la plataforma los configura aquí.
model HotmartCreditLink {
  id               String      @id @default(uuid())
  /// Cantidad de créditos que entrega el link.
  credits          Int
  /// Etiqueta visible ("1 crédito · mensual", "5 créditos · ahorro").
  label            String
  /// URL del checkout de Hotmart.
  url              String
  /// Precio en MXN (mostrado a clientes). Opcional.
  price            Decimal?    @db.Decimal(12, 2)
  currency         String      @default("MXN")
  /// Orden de despliegue.
  position         Int         @default(0)
  isActive         Boolean     @default(true)
  /// productId de Hotmart (`payload.data.product.id`). Cuando el webhook
  /// recibe un PURCHASE_APPROVED y este matchea, acreditamos automáticamente
  /// los créditos a la marca cuyo adminEmail = buyer.email.
  hotmartProductId String?
  /// offer code de Hotmart (`payload.data.purchase.offer.code`). Varias ofertas
  /// (1/10/20 créditos) comparten el MISMO productId, así que el productId solo
  /// NO distingue la cantidad. El webhook matchea por (productId + offerCode).
  /// null = link sin oferta específica (solo se usa si el producto tiene 1 link).
  hotmartOfferCode String?
  /// Marca blanca PROPIETARIA de este pack. La acreditación identifica la marca
  /// por (productId + offerCode) → este link → whiteLabelId, INDEPENDIENTE del
  /// correo del comprador (2026-06-23). null = pack global/legacy (→ Clubify).
  whiteLabelId     String?
  whiteLabel       WhiteLabel? @relation("WhiteLabelCreditLinks", fields: [whiteLabelId], references: [id], onDelete: Cascade)
  updatedAt        DateTime    @updatedAt

  purchases HotmartCreditPurchase[]

  @@index([isActive, position])
  @@index([hotmartProductId])
  @@index([whiteLabelId])
  @@index([hotmartProductId, hotmartOfferCode])
}

/// Registro de cada compra de pack de créditos hecha en Hotmart. Persistente
/// para idempotency (`transactionId UNIQUE`) y auditoría. Si el buyer.email
/// no matchea ninguna marca al momento de recibir el webhook, queda
/// UNASSIGNED y el PLATFORM_OWNER la reasigna manualmente desde
/// /superadmin/creditos.
model HotmartCreditPurchase {
  id               String             @id @default(uuid())
  transactionId    String             @unique
  /// productId de Hotmart (`payload.data.product.id`). Nullable porque
  /// las rows legacy (pre-2026-06-14) podían tener este valor en NULL.
  hotmartProductId String?
  creditLinkId     String?
  creditLink       HotmartCreditLink? @relation(fields: [creditLinkId], references: [id], onDelete: SetNull)
  credits          Int
  buyerEmail       String
  whiteLabelId     String?
  whiteLabel       WhiteLabel?        @relation(fields: [whiteLabelId], references: [id], onDelete: SetNull)
  /// ASSIGNED = créditos acreditados a una marca · UNASSIGNED = pendiente de
  /// reasignación manual · REFUNDED = pendiente cuando llegue evento de refund.
  status           String             @default("UNASSIGNED")
  /// Payload original del webhook (para debugging). Required en DB.
  rawPayload       Json
  createdAt        DateTime           @default(now())
  assignedAt       DateTime?

  @@index([status])
  @@index([whiteLabelId])
  @@index([buyerEmail])
}

/// Integraciones globales de la plataforma (NO marcas blancas). Ejemplo:
/// GrowBusiness SMS. Editables desde /superadmin/integraciones.
model PlatformIntegration {
  id          String   @id @default(uuid())
  /// Identificador de la integración ("grow_business").
  key         String   @unique
  /// Nombre visible ("GrowBusiness").
  name        String
  description String?  @db.Text
  /// Si está conectada y operativa.
  status      String   @default("DISCONNECTED")
  /// Credenciales/datos serializados (API key, config). En lectura se
  /// expone enmascarada al frontend.
  config      Json     @default("{}")
  updatedAt   DateTime @updatedAt
}

/// Invitaciones para sumar SUPER_ADMINs a una marca blanca específica.
/// Mismo patrón que PlatformOwnerInvite pero scoped a una marca: el
/// invitado queda como User role=SUPER_ADMIN, whiteLabelId=<marca>,
/// tenantId=null. Sólo ve los tenants de su marca.
model WhiteLabelAdminInvite {
  id           String     @id @default(uuid())
  whiteLabelId String
  whiteLabel   WhiteLabel @relation(fields: [whiteLabelId], references: [id], onDelete: Cascade)
  email        String
  fullName     String
  /// Hash SHA-256 del token. El token plano sólo se envía en el email.
  tokenHash    String     @unique
  invitedById  String
  invitedBy    User       @relation("WhiteLabelAdminInviteInviter", fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?      @relation("WhiteLabelAdminInviteAcceptor", fields: [acceptedById], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@index([whiteLabelId])
  @@index([email])
  @@index([acceptedAt, revokedAt])
}

/// Invitaciones para sumar nuevos PLATFORM_OWNERs a la consola Master Admin.
/// Flujo: el owner actual crea la invitación → mandamos email con link
/// `/aceptar-invitacion-plataforma/<token>` → el invitado define contraseña
/// y queda creado como User con role=PLATFORM_OWNER. Una invitación se
/// puede revocar mientras siga pendiente.
model PlatformOwnerInvite {
  id           String    @id @default(uuid())
  email        String
  fullName     String
  /// Hash SHA-256 del token. El token plano sólo se envía en el email.
  tokenHash    String    @unique
  invitedById  String
  invitedBy    User      @relation("PlatformOwnerInviteInviter", fields: [invitedById], references: [id])
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  acceptedBy   User?     @relation("PlatformOwnerInviteAcceptor", fields: [acceptedById], references: [id])
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([email])
  @@index([acceptedAt, revokedAt])
}

// ============================================================
//   CUPONERA / LIVING CARD (Fase 1) — campañas de beneficios comunitarios
// ------------------------------------------------------------
//   Marketplace de beneficios tipo Cuponatic: un miembro paga una membresía
//   y recibe una tarjeta digital en Wallet con la que redime beneficios en
//   negocios aliados. NO confundir con `model Campaign` (afiliados/referidos).
//   La campaña se respalda en un Tenant "de sistema" (Tenant.isCampaignHost)
//   para reusar TODO el stack Wallet (Card/Pass/Customer/Location/push).
// ============================================================

enum BenefitCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum MembershipInterval {
  MONTHLY
  ANNUAL
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipSource {
  MANUAL
  MERCADOPAGO
}

enum MembershipOrderStatus {
  PENDING
  PAID
  FAILED
}

/// Una campaña de beneficios comunitaria (la primera = "Living Card").
model BenefitCampaign {
  id           String                @id @default(uuid())
  /// Marca dueña de la campaña (aislamiento). Null = Clubify.
  whiteLabelId String?
  whiteLabel   WhiteLabel?           @relation(fields: [whiteLabelId], references: [id], onDelete: SetNull)
  /// Tenant "de sistema" que respalda la campaña (isCampaignHost=true). Aquí
  /// viven los Customer (miembros), el Card (plantilla) y los Location.
  tenantId     String                @unique
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Plantilla visual de la tarjeta Living Card (un Card del tenant de sistema).
  /// Null hasta que el admin la diseña por primera vez.
  cardId       String?
  name         String
  slug         String                @unique
  status       BenefitCampaignStatus @default(DRAFT)
  welcomeText  String                @default("")
  /// Branding del marketplace + credenciales MercadoPago (secretos CIFRADOS con
  /// secret-box). Forma: { mp: { accessToken(enc), webhookSecret(enc), publicKey },
  /// marketplace: {...} }.
  config       Json                  @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  plans         MembershipPlan[]
  categories    BenefitCategory[]
  memberships   LivingMembership[]
  orders        MembershipOrder[]
  allies        AllyBusiness[]
  benefits      Benefit[]
  redemptions   Redemption[]
  stampPrograms StampProgram[]
  stampCards    StampCard[]
  stampEvents   StampEvent[]

  @@index([whiteLabelId])
}

/// Plan de acceso a una campaña (Basic/Plus/VIP/Builder).
model MembershipPlan {
  id                  String             @id @default(uuid())
  campaignId          String
  campaign            BenefitCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name                String
  level               Int                @default(0)
  /// Precio en la unidad menor de la moneda. COP no tiene decimales → son pesos.
  priceCents          Int                @default(0)
  currency            String             @default("COP")
  interval            MembershipInterval @default(MONTHLY)
  /// Nº de beneficios incluidos. Null = ilimitado.
  benefitsAllowance   Int?
  description         String             @default("")
  isActive            Boolean            @default(true)
  sortOrder           Int                @default(0)
  /// Id del plan de preapproval en MercadoPago (si se asocia a un plan MP).
  mpPreapprovalPlanId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memberships LivingMembership[]
  orders      MembershipOrder[]

  @@index([campaignId])
}

/// Membresía de un cliente (Customer del tenant de sistema) a una campaña.
model LivingMembership {
  id              String           @id @default(uuid())
  campaignId      String
  campaign        BenefitCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  planId          String?
  plan            MembershipPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  status          MembershipStatus @default(PENDING)
  source          MembershipSource @default(MANUAL)
  memberLevel     Int              @default(0)
  activatedAt     DateTime?
  expiresAt       DateTime?
  /// Pass emitido (Wallet). Se llena al activar la membresía.
  passId          String?
  mpPreapprovalId String?
  mpPayerId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([campaignId, customerId])
  @@index([customerId])
  @@index([status])
}

/// Categoría de beneficios administrable (Restaurantes, Cafés, Living Kids…).
model BenefitCategory {
  id         String          @id @default(uuid())
  campaignId String
  campaign   BenefitCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  icon       String          @default("")
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  allies        AllyBusiness[]
  benefits      Benefit[]
  stampPrograms StampProgram[]

  @@unique([campaignId, slug])
  @@index([campaignId])
}

/// Orden de pago de una membresía (provider-agnóstico; hoy MercadoPago).
model MembershipOrder {
  id          String                @id @default(uuid())
  campaignId  String
  campaign    BenefitCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  planId      String?
  plan        MembershipPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
  customerId  String?
  email       String                @default("")
  amountCents Int                   @default(0)
  currency    String                @default("COP")
  status      MembershipOrderStatus @default(PENDING)
  provider    PaymentGateway        @default(MERCADOPAGO)
  /// Referencia externa (preapproval id / payment id de MercadoPago).
  providerRef String?
  rawPayload  Json                  @default("{}")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([campaignId])
  @@index([providerRef])
}

/// Idempotencia del webhook MercadoPago (análogo a StripeWebhookEvent).
model MercadopagoWebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  eventType   String
  campaignId  String?
  payload     Json
  processedAt DateTime @default(now())

  @@index([campaignId, eventType, processedAt])
}

/// Estado de un negocio aliado dentro de una campaña. La campaña aprueba
/// (o rechaza) antes de que su ficha sea visible en el marketplace.
enum AllyStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/// Negocio aliado de una campaña (Fase 2). Entidad ligera con su propio login
/// (User role=ALLY_BUSINESS vía User.allyBusinessId) y portal, SIN la maquinaria
/// de suscripción de un Tenant. Mismo patrón que DeliveryCompany.
model AllyBusiness {
  id          String           @id @default(uuid())
  campaignId  String
  campaign    BenefitCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// Categoría del marketplace (Restaurantes, Cafés…). Opcional.
  categoryId  String?
  category    BenefitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  slug        String           @unique
  description String           @default("")
  logoUrl     String?
  coverUrl    String?
  /// Galería de fotos (array de URLs).
  photos      Json             @default("[]")
  address     String           @default("")
  city        String           @default("")
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  /// Horarios (JSON libre, ej. { mon: "8-18", ... } o texto).
  hours       Json             @default("{}")
  whatsapp    String?
  instagram   String?
  website     String?
  status      AllyStatus       @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  /// Cuentas de login del negocio (role=ALLY_BUSINESS).
  admins      User[]       @relation("AllyBusinessAdmin")
  benefits    Benefit[]
  redemptions Redemption[]
  stampEvents StampEvent[]

  @@index([campaignId, status])
  @@index([categoryId])
}

/// Tipo de beneficio/promoción publicado por un negocio aliado (Fase 3).
enum BenefitType {
  PERCENT_OFF
  AMOUNT_OFF
  TWO_FOR_ONE
  FREEBIE
  PRODUCT
  OTHER
}

enum BenefitStatus {
  DRAFT
  ACTIVE
  PAUSED
}

/// Aprobación por la campaña (si `config.requireBenefitApproval`). Los
/// beneficios creados por el admin nacen APPROVED; los del aliado, PENDING.
enum BenefitApproval {
  PENDING
  APPROVED
  REJECTED
}

/// Un beneficio/promoción de un negocio aliado dentro de una campaña.
model Benefit {
  id               String           @id @default(uuid())
  campaignId       String
  campaign         BenefitCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  allyBusinessId   String
  ally             AllyBusiness     @relation(fields: [allyBusinessId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         BenefitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type             BenefitType      @default(PERCENT_OFF)
  title            String
  description      String           @default("")
  imageUrl         String?
  terms            String           @default("")
  /// % de descuento (type=PERCENT_OFF).
  percentOff       Int?
  /// Descuento en dinero / precios de producto, en la unidad menor (COP=pesos).
  amountOffCents   Int?
  normalPriceCents Int?
  memberPriceCents Int?
  currency         String           @default("COP")
  validFrom        DateTime?
  validUntil       DateTime?
  /// Límite total de canjes (null = ilimitado).
  maxRedemptions   Int?
  /// Límite por miembro (null = ilimitado; 1 = un solo uso).
  maxPerMember     Int?             @default(1)
  status           BenefitStatus    @default(ACTIVE)
  approval         BenefitApproval  @default(APPROVED)
  /// Contador denormalizado de canjes (fuente de verdad: tabla Redemption).
  redemptionCount  Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  redemptions Redemption[]

  @@index([campaignId, status, approval])
  @@index([allyBusinessId])
  @@index([categoryId])
}

/// Registro de un canje (un miembro redimió un beneficio en un negocio).
model Redemption {
  id             String          @id @default(uuid())
  campaignId     String
  campaign       BenefitCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  benefitId      String
  benefit        Benefit         @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  allyBusinessId String
  ally           AllyBusiness    @relation(fields: [allyBusinessId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passId         String?
  /// Usuario (cuenta del aliado) que registró el canje.
  operatorUserId String?
  createdAt      DateTime        @default(now())

  @@index([benefitId, customerId])
  @@index([allyBusinessId, createdAt])
  @@index([campaignId, createdAt])
}

enum StampProgramStatus {
  ACTIVE
  PAUSED
}

enum StampEventAction {
  STAMP
  REDEEM
}

/// Programa de sellos comunitario (Fase 5). El miembro acumula sellos canjeando
/// en negocios aliados; al completar `stampsRequired` obtiene el premio.
/// `categoryId` null = cuenta en cualquier aliado; si está, solo en esa categoría.
model StampProgram {
  id             String             @id @default(uuid())
  campaignId     String
  campaign       BenefitCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       BenefitCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String             @default("")
  imageUrl       String?
  stampsRequired Int                @default(5)
  rewardText     String             @default("")
  /// Máximo de sellos por miembro por día (anti-abuso). Default 1.
  maxPerDay      Int                @default(1)
  status         StampProgramStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  cards  StampCard[]
  events StampEvent[]

  @@index([campaignId, status])
  @@index([categoryId])
}

/// Progreso de un miembro en un programa de sellos.
model StampCard {
  id              String          @id @default(uuid())
  campaignId      String
  campaign        BenefitCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  programId       String
  program         StampProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stampsCount     Int             @default(0)
  cyclesCompleted Int             @default(0)
  lastStampAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([programId, customerId])
  @@index([customerId])
}

/// Log de cada sello otorgado o premio canjeado (historial + límite diario).
model StampEvent {
  id             String           @id @default(uuid())
  campaignId     String
  campaign       BenefitCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  programId      String
  program        StampProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  customerId     String
  allyBusinessId String?
  ally           AllyBusiness?    @relation(fields: [allyBusinessId], references: [id], onDelete: SetNull)
  operatorUserId String?
  action         StampEventAction
  createdAt      DateTime         @default(now())

  @@index([programId, customerId, createdAt])
  @@index([allyBusinessId, createdAt])
}
