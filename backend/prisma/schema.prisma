enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  // RETAINED — el SUPER_ADMIN frenó el pago temporalmente (ej: el
  // cliente disputó el pago, problema de KYC del afiliado). NO entra
  // en "Listo por pagar". Vuelve a APPROVED manual.
  RETAINED
  // ADJUSTMENT — asiento negativo (clawback) por reembolso/contracargo de una
  // comisión YA PAGADA. No modifica el histórico; se descuenta en el próximo
  // corte del beneficiario. (Fase 7 — overhaul comisiones.)
  ADJUSTMENT
}

/// Modo de reparto de la comisión del vendedor respecto al upline (embajador/
/// influencer). Configurable por negocio (Fase 3 — overhaul comisiones).
enum CommissionDistributionMode {
  /// El % del vendedor SALE de la tajada del upline (no sube el costo total).
  DISCOUNT_FROM_INFLUENCER
  /// El % del vendedor es un costo ADICIONAL que asume la empresa (sube total).
  ADDITIONAL_COMPANY_COMMISSION
}

// Método de pago elegido por el afiliado para recibir comisiones.
enum PaymentMethodKind {
  BINANCE
  BANK
}

// Estado del perfil de pago del afiliado. El SUPER_ADMIN revisa los
// datos antes de habilitarlo (no queremos pagar a una cuenta mal
// digitada). Solo APPROVED entra en la lista "Listo por pagar".
enum PaymentProfileStatus {
  NONE // no llenó el form todavía
  PENDING_REVIEW // llenó pero admin no validó
  APPROVED
  REJECTED
}

// Estado del batch de pago al afiliado.
enum CommissionPayoutStatus {
  PROCESSING // admin creó el row pero todavía no marcó como pagado
  PAID // admin transfirió + adjuntó comprobante
  REVERSED // hubo error, se revirtió (las commissions vuelven a APPROVED)
}

// Tracking de pago granular sobre Commission (independiente del status
// del flow de aprobación). PAID en `status` = aprobada y marcada como
// pagada conceptualmente; `paymentStatus` permite pagos parciales y
// reconciliación contable: PENDING (nada pagado), PARTIAL (pagado <
// amount), PAID (pagado >= amount). Default PENDING.
enum CommissionPaymentStatus {
  PENDING
  PARTIAL
  PAID
}

