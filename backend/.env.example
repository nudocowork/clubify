# ───────────── Required en producción ─────────────
NODE_ENV=production
PORT=3001                          # Railway/Render lo inyectan automáticamente

# Postgres — Railway/Render/Neon te lo dan.
# En PROD agregá connection pool: ?connection_limit=20&pool_timeout=20
#   (sin esto Prisma usa 10 por default, se satura rápido en multi-tenant).
DATABASE_URL=postgresql://user:pass@host:5432/clubify?connection_limit=20&pool_timeout=20

# Redis (opcional por ahora — sin uso hasta que activemos BullMQ workers)
REDIS_URL=redis://host:6379

# JWT secrets — generá con: openssl rand -base64 48
JWT_SECRET=__generar_con_openssl_rand_base64_48__
JWT_REFRESH_SECRET=__generar_con_openssl_rand_base64_48__
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# QR signing (HMAC) — generá con: openssl rand -base64 32
QR_HMAC_SECRET=__generar_con_openssl_rand_base64_32__

# URLs públicas (CORS, wa.me deeplinks, redirects de pago, webhook URLs)
APP_URL=https://soyclubify.com
API_URL=https://api.soyclubify.com

# ───────────── Object storage (S3-compatible) ─────────────
# Recomendado: Cloudflare R2 — gratis hasta 10GB, sin egress fees.
#   https://dash.cloudflare.com/?to=/:account/r2
#
# Para escala internacional: poné un custom domain con Cloudflare proxy
# delante del bucket público en lugar de usar pub-*.r2.dev directamente.
#   1) R2 dashboard → settings del bucket → "Public access" → connect domain
#   2) Apuntá un CNAME `cdn.soyclubify.com` al bucket
#   3) Cloudflare auto-aplica cache + brotli + DDoS shield (gratis)
#   4) Acá setea: S3_PUBLIC_URL=https://cdn.soyclubify.com
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=clubify-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=https://pub-<bucket_id>.r2.dev
S3_FORCE_PATH_STYLE=true

# ───────────── Apple Wallet (opcional) ─────────────
APPLE_PASS_TYPE_ID=pass.com.soyclubify.loyalty
APPLE_TEAM_ID=
APPLE_PASS_CERT_PATH=./certs/pass.pem
APPLE_PASS_CERT_PASSWORD=
APPLE_WWDR_PATH=./certs/wwdr.pem
APNS_KEY_PATH=./certs/apns.p8
APNS_KEY_ID=
APNS_TEAM_ID=

# ───────────── Google Wallet (opcional) ─────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON=./certs/google-wallet-sa.json

# ───────────── SMTP (opcional, para emails transaccionales) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clubify <noreply@soyclubify.com>

# ───────────── Sentry (opcional) ─────────────
# Backend errors → https://sentry.io. Sin DSN: Sentry queda inerte.
SENTRY_DSN=
SENTRY_RELEASE=
# Si querés mandar PII (cookies, headers) para debug: SENTRY_SEND_PII=true

# ───────────── Retención de tablas calientes (opcional) ─────────────
# OFF por default. Activá en prod cuando estés seguro:
#   RETENTION_ENABLED=true
# Thresholds personalizables (días). Defaults arriba van bien.
RETENTION_ENABLED=
# RETENTION_DAYS_EVENT=90
# RETENTION_DAYS_AUDIT=365
# RETENTION_DAYS_NOTIFICATION=30
# RETENTION_DAYS_REFRESH_TOKEN=7

# ───────────── Swagger (opcional, recomendado en prod) ─────────────
# Si seteás user/password, Swagger queda accesible en /api/docs con basic
# auth. En prod SIN estos vars seteados, /api/docs devuelve 404 (oculto).
SWAGGER_USER=
SWAGGER_PASSWORD=

# ───────────── Backups DB (scripts/backup-db.mjs) ─────────────
# Key de 32 bytes generado con: openssl rand -base64 32
# La MISMA key se necesita para restore-db.mjs — guardala fuera del repo.
BACKUP_ENCRYPTION_KEY=
# Bucket donde se guardan los backups (puede ser el mismo S3_BUCKET o uno
# separado). Si separado: setearlo en GH Actions secrets como
# S3_BACKUP_BUCKET. Default: usa S3_BUCKET.
# BACKUP_PREFIX=backups/
# BACKUP_RETENTION_DAYS=30

# ───────────── Pagos online (opcional, ver PENDIENTES.md §11) ─────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# WOMPI_PUBLIC_KEY=pub_prod_...
# WOMPI_PRIVATE_KEY=prv_prod_...
